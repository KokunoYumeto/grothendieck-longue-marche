{
  "a_x": [
    {
      "coefficient": "1",
      "bracket": "[x,[x,[[x,y],y]]]"
    },
    {
      "coefficient": "-2",
      "bracket": "[[x,[x,y]],[x,y]]"
    }
  ],
  "a_y": [
    {
      "coefficient": "1",
      "bracket": "[x,[x,[x,[x,y]]]]"
    }
  ],
  "convention": "D(x)=[a_x,x], D(y)=[a_y,y]",
  "sum_zero": true,
  "transposition_invariant": false
}
