@article{C_AartsOversteegen1991,
  author = {Aarts, J. M. and Oversteegen, L. G.},
  title = {Flowbox manifolds},
  journal = {Transactions of the American Mathematical Society},
  volume = {327},
  number = {1},
  year = {1991},
  pages = {449--463},
  doi = {10.1090/S0002-9947-1991-1042286-8},
  url = {https://www.researchgate.net/publication/238598319_Flowbox_Manifolds},
  note = {Verified: the author-uploaded original published text was read, including Definition 1.1, Main Theorem 0.5, the construction in Section 4, Remark 4.4, and Definition 5.3 with Theorems 5.6--5.7 on page 460. The regularity condition is the existence of arbitrarily close arc embeddings through all nearby points. The cited Whitney local-section construction was also read in Section 3 of Aarts--Hagopian--Oversteegen, Pacific Journal of Mathematics 150 (1991), 1--12, in the publisher's primary PDF. The auxiliary global flow is not claimed to preserve the original operator action.}
}

@article{C_BaillifGabard2008,
  author = {Baillif, Mathieu and Gabard, Alexandre},
  title = {Manifolds: {Hausdorffness} versus homogeneity},
  journal = {Proceedings of the American Mathematical Society},
  volume = {136},
  number = {3},
  year = {2008},
  pages = {1105--1111},
  doi = {10.1090/S0002-9939-07-09100-9},
  url = {https://access.archive-ouverte.unige.ch/access/metadata/3dfff744-545f-4c92-a97d-5226fc787571/download},
  note = {Verified: Theorem 1.1 on page 1106 and its full proof in Section 4, pages 1109--1110, were read in the published version deposited in the University of Geneva archive. The theorem allows non-Hausdorff manifolds initially and proves that a homogeneous Lindelof manifold is Hausdorff. The proof uses dense Hausdorff open sets, a countable subcover, the Baire property, and homogeneity.}
}
