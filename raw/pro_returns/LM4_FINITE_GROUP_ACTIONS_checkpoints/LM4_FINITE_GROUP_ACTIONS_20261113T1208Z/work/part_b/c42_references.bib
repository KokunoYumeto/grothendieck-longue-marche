@misc{C_Polulyakh2000,
  author = {Polulyakh, Eugene},
  title = {On the theorem converse to {Jordan}'s curve theorem},
  year = {2000},
  eprint = {math/0009164},
  archivePrefix = {arXiv},
  primaryClass = {math.GT},
  url = {https://arxiv.org/pdf/math/0009164},
  note = {Verified: version 1, Theorem 1.1 and Corollary 1.1 on page 7, with the proofs through sections 1.3--2, were read in the primary preprint. A compact connected planar set with exactly two complementary domains is Jordan when its inaccessible subsets from either domain are zero-dimensional. This is applied after compactification with defects confined to one point.}
}

