@article{C_Frankel2015,
  author = {Frankel, Steven},
  title = {Quasigeodesic flows and sphere-filling curves},
  journal = {Geometry \& Topology},
  volume = {19},
  number = {3},
  year = {2015},
  pages = {1249--1262},
  doi = {10.2140/gt.2015.19.1249},
  url = {https://msp.org/gt/2015/19-3/gt-v19-n3-p03-s.pdf},
  note = {Verified: Lemma 2.7 and its proof on printed page 1258 apply to arbitrary closed planar separating sets, including unbounded sets. The connected frontier of the complementary domain V is contained in A and separates the specified points. The final printed phrase should select the component containing that frontier; the present proof writes this explicitly.}
