\\ Candidate extraction only: no BNF, class or regulator completeness.
default(parisizemax,1500000000);
default(parisize,256000000);
default(realprecision,100);setrand(170);
x='x;y='y;d=649;P=y^18+3*d^6;
print("START EXACT FIELD");
E=nfinit([P,[2,3,11,59]]);
print("NF READY ",nfcertify(E));
W=Mod(y,P);Z=(W^9/d^3-1)/2;T=-Z*W^2;
if(Z^2+Z+1 || T^9-3*d^6,error("field map"));
C=(111788801111376922216738575261847961659795416061049994983189368625819146903772611400880544938526)*T^0+(1319942546417866449873539427988410014544742915359255190183926495496105455497114942303866963236)*T^1+(10114780302064925365159658580112077608492570000918813677446977258891211530642336810989852553790/649)*T^2+(7046365963337631951451138426310369161917892961435743599727958289607494712288665886737809693496/38291)*T^3+(915197046053913687207640339142249669184805121548019458616671241750583279772677324553055938869/421201)*T^4+(7013196960016434475379006273478892793758306507836437095284025248248348413035321955988956183521/273359449)*T^5+(53742450122687900492370850929077807177499815696083985258011213569988830383983235896343797378105/177410282401)*T^6+(634562190133878115345373639370484071650733194575288402845872362242395037146277015822346840185/177410282401)*T^7+(82418291211338852300988273969148287415218171684857859767275429643866481817915956642462322387/1951513106411)*T^8;
C1=subst(lift(C),y,Z^2*W);
C1=Mod(C1,P);C2=Mod(subst(lift(C),y,Z*W),P);V=C1/C2;
print("START ROOT ",2);
R=nfroots(E,x^3-V);
print("ROOT COUNT ",2, " ",#R);
for(j=1,#R,if(R[j]^3!=V,error("returned root")));
if(#R,print("ROOT COEFFICIENTS ",2, " ",Vecrev(lift(R[1]))));
C=()*T^0+(-)*T^1+(-)*T^2+()*T^3+()*T^4+(-)*T^5+(-)*T^6+()*T^7+()*T^8;
C1=subst(lift(C),y,Z^2*W);
C1=Mod(C1,P);C2=Mod(subst(lift(C),y,Z*W),P);V=C1/C2;
print("START ROOT ",3);
R=nfroots(E,x^3-V);
print("ROOT COUNT ",3, " ",#R);
for(j=1,#R,if(R[j]^3!=V,error("returned root")));
if(#R,print("ROOT COEFFICIENTS ",3, " ",Vecrev(lift(R[1]))));
C=()*T^0+()*T^1+(-)*T^2+(-)*T^3+(-)*T^4+(-)*T^5+()*T^6+()*T^7+()*T^8;
C1=subst(lift(C),y,Z^2*W);
C1=Mod(C1,P);C2=Mod(subst(lift(C),y,Z*W),P);V=C1/C2;
print("START ROOT ",4);
R=nfroots(E,x^3-V);
print("ROOT COUNT ",4, " ",#R);
for(j=1,#R,if(R[j]^3!=V,error("returned root")));
if(#R,print("ROOT COEFFICIENTS ",4, " ",Vecrev(lift(R[1]))));
quit;
