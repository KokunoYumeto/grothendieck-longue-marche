@article{A-Morales2024,
 author={Ismael Morales},
 title={On the profinite rigidity of free and surface groups},
 journal={Mathematische Annalen},
 volume={390}, year={2024}, pages={1507--1540},
 doi={10.1007/s00208-023-02785-6},
 url={https://link.springer.com/content/pdf/10.1007/s00208-023-02785-6.pdf},
 note={Verified: original complete publisher PDF and HTML opened and inspected. Propositions 2.14--2.15 on printed pages 1515--1516 prove that every lower-central quotient of an orientable surface group's pro-p completion is torsion-free and that their intersection is trivial; the proof includes the exact completion/quotient comparison. The present argument uses these statements, not an unproved identification of full and pro-p groups.}
}
