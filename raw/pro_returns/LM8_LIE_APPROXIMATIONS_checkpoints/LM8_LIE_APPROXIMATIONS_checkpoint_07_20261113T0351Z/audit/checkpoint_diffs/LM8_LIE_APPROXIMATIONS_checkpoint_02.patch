+\begin{split}
+ \epsilon_k(a)&=[B_{k-1},a],\\
+ \epsilon_k(b)&=[B_{k-1},b]
+ -\sum_{\substack{j+h=k-1\\j>h>0}}(-1)^j[B_j,B_h].
+\end{split}
