# Exact finite tests for the rank-two pure peripheral involution problem.
# All ordered pairs in every SmallGroups group of order <= 48 are tested.
# The second test is the relatively free rank-two group in the variety
# generated by S3, using every ordered pair of S3 as an evaluation coordinate.
SetInfoLevel(InfoPackageLoading,0);;
LoadPackage("SmallGrp");;
Assert(0,IsBound(SmallGroup));
Print("GAP_VERSION ",GAPInfo.Version,"\n");
Print("SMALLGRP_VERSION ",PackageInfo("smallgrp")[1].Version,"\n");
Print("SMALLGRP_INSTALLATION_PATH ",PackageInfo("smallgrp")[1].InstallationPath,"\n");
totalGroups:=0;;totalPairs:=0;;totalFailures:=0;;
exponent:=1;;
for n in [1..48] do
  failGroups:=[];;pairCount:=0;;failureCount:=0;;
  for gid in [1..NrSmallGroups(n)] do
    G:=SmallGroup(n,gid);;els:=Elements(G);;expG:=Exponent(G);;
    evenpart:=1;;oddpart:=expG;;
    while oddpart mod 2=0 do evenpart:=2*evenpart;;oddpart:=oddpart/2;;od;
    if evenpart=1 then exponent:=1;
    elif oddpart=1 then exponent:=expG-1;
    else exponent:=ChineseRem([evenpart,oddpart],[evenpart-1,1]);fi;
    cc:=ConjugacyClasses(G);;dict:=NewDictionary(One(G),true);;
    for ci in [1..Length(cc)] do for z in Elements(cc[ci]) do AddDictionary(dict,z,ci);od;od;
    pw:=List(els,z->z^exponent);;failing:=0;;first:=fail;;
    for i in [1..n] do for j in [1..n] do
      pairCount:=pairCount+1;;
      if LookupDictionary(dict,pw[i]*pw[j])<>LookupDictionary(dict,(els[i]*els[j])^exponent) then
        failing:=failing+1;;
        if first=fail then first:=[i,j,Order(els[i]),Order(els[j]),Order(els[i]*els[j]),Size(Group(els[i],els[j]))];fi;
      fi;
    od;od;
    if failing>0 then
      Add(failGroups,gid);;failureCount:=failureCount+failing;;
      Print("FAILURE ",n," ",gid," ",failing," ",first," ",StructureDescription(G),"\n");
    fi;
  od;
  totalGroups:=totalGroups+NrSmallGroups(n);;totalPairs:=totalPairs+pairCount;;totalFailures:=totalFailures+failureCount;;
  Print("ORDER ",n," GROUPS ",NrSmallGroups(n)," PAIRS ",pairCount," FAIL_GROUPS ",failGroups," FAIL_PAIRS ",failureCount,"\n");
od;
Print("TOTAL_GROUPS ",totalGroups," TOTAL_PAIRS ",totalPairs," TOTAL_FAIL_PAIRS ",totalFailures,"\n");

S:=SymmetricGroup(3);;se:=Elements(S);;xp:=[];;yp:=[];;block:=0;;
for xx in se do for yy in se do
  for z in [1..3] do Add(xp,3*block+z^xx);Add(yp,3*block+z^yy);od;
  block:=block+1;;
od;od;
xxU:=PermList(xp);;yyU:=PermList(yp);;U:=Group(xxU,yyU);;D:=DerivedSubgroup(U);;
Print("UNIVERSAL_S3_ORDER ",Size(U)," DERIVED_ORDER ",Size(D),"\n");
normPass:=[];;peripheralPass:=[];;fullPass:=[];;
for f in Elements(D) do
  phi:=GroupHomomorphismByImages(U,U,[xxU,yyU],[xxU,yyU^f]);;
  Assert(0,phi<>fail);
  normOK:=f*Image(phi,f)=One(U);;
  # For an actual multiplier-one torsion lift the third conjugator can
  # also be normalized into the closed commutator subgroup (A.19).
  periOK:=ForAny(Elements(D),h->xxU*(yyU^f)=(xxU*yyU)^h);;
  if normOK then Add(normPass,f);fi;
  if periOK then Add(peripheralPass,f);fi;
  if normOK and periOK then Add(fullPass,f);fi;
od;
Print("UNIVERSAL_S3_NORM_PASS ",Length(normPass)," PERIPHERAL_DERIVED_PASS ",Length(peripheralPass)," JOINT_PASS ",Length(fullPass),"\n");
Print("UNIVERSAL_S3_JOINT_ONLY_IDENTITY ",fullPass=[One(U)],"\n");
QUIT_GAP(0);
