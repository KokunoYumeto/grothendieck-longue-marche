PBC_new:=ShallowCopy(AsList(PBC_old));;PBC_used:=[];;PBC_changes:=[];;
PBC_replace:=function(h,label) local v,i,u;v:=ExponentsOfPcElement(PBC_old,h);i:=PositionProperty(v,a->a<>0);if i=fail or i in PBC_used then return;fi;u:=First([1..PBC_orders[i]-1],q->q*v[i] mod PBC_orders[i]=1);Assert(0,u<>fail);PBC_new[i]:=h^u;AddSet(PBC_used,i);Add(PBC_changes,[i,label,u]);end;;
