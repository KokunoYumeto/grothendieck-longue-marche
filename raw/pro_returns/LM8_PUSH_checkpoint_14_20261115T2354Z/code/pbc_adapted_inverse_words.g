PBC_word:=function(el) local h,d,e,w;h:=el;w:=[];while not IsOne(h) do d:=DepthOfPcElement(PBC_old,h);e:=ExponentOfPcElement(PBC_old,h,d);Assert(0,e>0 and e<PBC_orders[d]);Append(w,[d,e]);h:=PBC_invs[d][e+1]*h;od;return w;end;;
Print("native_triangular_basis_verified ",Length(PBC_changes)," runtime ",Runtime(),"\n");
PBC_actual_orders:=List(PBC_new,Order);;
PBC_inverse_words:=List([1..Length(PBC_new)],i->PBC_word(PBC_invs[i][2]));;
Assert(0,ForAll([1..Length(PBC_new)],i->PBC_new[i]*PBC_invs[i][2]=One(PBC_Native)));
