LoadPackage("polycyclic");;
PBC_orders:=[3,2,3,3];;
PBC_free:=FreeGroup(4);;
PBC_family:=FamilyObj(PBC_free.1);;
PBC_rws:=SingleCollector(PBC_free,PBC_orders);;
SetPower(PBC_rws,1,ObjByExtRep(PBC_family,[]));;
SetPower(PBC_rws,2,ObjByExtRep(PBC_family,[]));;
SetPower(PBC_rws,3,ObjByExtRep(PBC_family,[]));;
SetPower(PBC_rws,4,ObjByExtRep(PBC_family,[]));;
SetConjugate(PBC_rws,2,1,ObjByExtRep(PBC_family,[2,1,4,2]));;
SetConjugate(PBC_rws,3,1,ObjByExtRep(PBC_family,[3,1]));;
SetConjugate(PBC_rws,3,2,ObjByExtRep(PBC_family,[3,2]));;
SetConjugate(PBC_rws,4,1,ObjByExtRep(PBC_family,[3,1,4,1]));;
SetConjugate(PBC_rws,4,2,ObjByExtRep(PBC_family,[4,2]));;
SetConjugate(PBC_rws,4,3,ObjByExtRep(PBC_family,[4,1]));;
PBC_G:=GroupByRwsNC(PBC_rws);;
Assert(0,Size(PBC_G)=54);
PBC_Pcp:=Image(IsomorphismPcpGroup(PBC_G));;
PBC_mult:=AbelianInvariantsMultiplier(PBC_Pcp);;
PBC_threepart:=function(e) local a; a:=1; while e mod 3=0 do a:=3*a; e:=e/3; od; return a; end;;
PBC_part:=List(PBC_mult,PBC_threepart);;
if Length(PBC_part)=0 then PBC_base:=1;else PBC_base:=Lcm(PBC_part);fi;
PBC_bound:=81*PBC_base;;
PrintTo("LM8_PUSH/code/pbc_three_h2_layer_bound_base.json","{\n\"base_order\":54,\n\"base_integral_multiplier\":",PBC_mult,",\n\"base_three_primary_exponent\":",PBC_base,",\n\"full_three_primary_annihilator\":",PBC_bound,",\n\"full_integral_annihilator_with_old_two_bound\":",2^14*PBC_bound,"\n}\n");
Print("ACTUAL_ORDER54_MULTIPLIER ",PBC_mult," BASE3EXP ",PBC_base," FULL3_BOUND ",PBC_bound," FULL_INTEGRAL_BOUND ",2^14*PBC_bound,"\n");
QUIT;
