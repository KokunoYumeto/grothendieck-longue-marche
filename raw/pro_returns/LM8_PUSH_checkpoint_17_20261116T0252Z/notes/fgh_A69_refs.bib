  editor = {Cornelissen, Gunther and Oort, Frans},
  series = {Rendiconti del Seminario Matematico della Universit\`a di Padova},
  volume = {113},
  year = {2005},
  url = {https://arxiv.org/pdf/math/0411059},
  note = {verified: original published Theorem 6.13, p.154, and readable author version, p.21, opened. The theorem gives a tree stable fibre and potential good Jacobian for a nilpotent cover with good base, etale branch closure and generic tameness. Only this ramified tree conclusion is used; no marked-fibre slope statement is inferred.}
