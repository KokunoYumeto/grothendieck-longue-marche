     copies = {e['original_path']: e for e in mapping.get('exact_file_copies', [])}
 
     def exact_entry(name, expected_hash, expected_bytes=None):
+        if name in transformed:
+            transformed_entry = transformed[name]
+            assert transformed_entry['kind'] == 'raw_bytes', name
+            assert transformed_entry['decoded_sha256'] == expected_hash, name
+            if expected_bytes is not None:
+                assert transformed_entry['decoded_bytes'] == expected_bytes, name
+            return
         if name in copies:
             copy = copies[name]
             assert copy['sha256'] == expected_hash
@@ -62,6 +69,17 @@
         for arg in entry.get('restore_command', []):
             if arg.startswith('{archive}/'):
                 assert arg[len('{archive}/'):] in entries, arg
+        if entry['codec'] == 'ZSTD_PDF_DICT01':
+            recipe = json.loads(archive.read(entry['stored_path']))
