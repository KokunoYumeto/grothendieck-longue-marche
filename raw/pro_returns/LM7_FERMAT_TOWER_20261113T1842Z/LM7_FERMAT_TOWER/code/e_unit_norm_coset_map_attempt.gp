\\ E97: a literal norm switch and its complete ordinary ideal-class defect.
\\ Only the certified degree-six lower genus computation is an input.
default(parisize,256000000);
default(parisizemax,2000000000);
default(realprecision,100);
setrand(971713);
check(b,s)=if(!b,error(s));
jfrac(q)=[numerator(q),denominator(q)];
jpoly(p,n)=vector(n,i,jfrac(polcoef(lift(p),i-1)));
jmat(M)=vector(matsize(M)[1],i,vector(matsize(M)[2],j,M[i,j]));
jmatq(M)=vector(matsize(M)[1],i,vector(matsize(M)[2],j,jfrac(M[i,j])));
emit(n,v)=print("{\"name\":\"",n,"\",\"value\":",v,"}");
red(v,d)=vector(#d,i,lift(Mod(v[i],d[i])))~;
run()={
  my(lo=read("research_e86/code/e_stable_lower_genus.bin"),BL=lo[1],FL=BL.nf,pl=FL.pol,b=Mod(x,pl),z=b^3/17);
  check(bnfcertify(BL)==1 && BL.cyc==[3,3],"certified degree-six lower class group");
  my(C=[-717026,-1721029,-474164,29437,-20479,-31853;
        -2831945,130475,550222,53428,-19498,-6494;
        -2266763,678062,13447,-275174,-49207,9805],den=11169);
  my(uu=vector(3,j,sum(i=0,5,C[j,i+1]*b^i)/den),Y=varhigher("Y",x),u=Mod(sum(j=0,2,uu[j+1]*Y^j),Y^3-z));
  check(norm(u)==b,"literal horizontal norm beta1");
  my(A=[0,0,z;1,0,0;0,1,0],S=matdiagonal([1,z,z^2]),B=sum(j=0,2,uu[j+1]*A^j)*S);
  check(A^3==z*matid(3) && B^3==b*matid(3) && B*A==z*A*B,"split cyclic-algebra identities");
  my(Z=varhigher("Z",Y),t=Mod(Z,Z^3-b),ker=matker(B-t*matid(3)));
  check(matsize(ker)==[3,1],"one-dimensional eigenline");
  my(v=ker[,1]);check(v[3]!=0,"specified eigenline normalization");v=v/v[3];
  my(tv=vector(3,i,Mod(subst(lift(v[i]),Z,z*Z),Z^3-b))~,w=(A*v)[1]/tv[1]);
  check(A*v==w*tv && norm(w)==z,"exact switched norm zeta");
  my(pa=x^18+17*x^9+289,L=nfinit(pa),aa=Mod(x,pa),wa=Mod(0,pa));
  for(j=0,2,wa+=subst(lift(polcoef(lift(w),j,Z)),x,aa^3)*aa^j);
  my(za=aa^9/17,aut=nfalgtobasis(L,za*aa),av=nfalgtobasis(L,wa),sw=nfgaloisapply(L,aut,av),s2w=nfgaloisapply(L,aut,sw));
  check(nfeltmul(L,nfeltmul(L,av,sw),s2w)==nfalgtobasis(L,za),"absolute norm identity");
  my(fac=idealfactor(L,wa),seen=Map(),D=matid(18),arts=vector(#lo[6],i,0)~,rows=List(),primes=List());
  for(j=1,matsize(fac)[1],
    my(P=fac[j,1],I=idealhnf(L,P));
    if(mapisdefined(seen,Str(I)),next);
    my(I1=idealhnf(L,nfgaloisapply(L,aut,I)),I2=idealhnf(L,nfgaloisapply(L,aut,I1)),orb=[I,I1,I2]);
    check(I!=I1 && I!=I2 && I1!=I2 && idealhnf(L,nfgaloisapply(L,aut,I2))==I,"actual split prime orbit");
    my(vv=vector(3,i,sum(jj=1,matsize(fac)[1],if(idealhnf(L,fac[jj,1])==orb[i],fac[jj,2],0))),dd=[0,-vv[2],vv[1]]);
    check(sum(i=1,3,vv[i])==0,"zero norm of witness divisor");
    for(i=1,3,seen[Str(orb[i])]=1);
    D=idealmul(L,D,idealmul(L,idealpow(L,I1,dd[2]),idealpow(L,I2,dd[3])));
    my(p=P[1],mp=nfmodprinit(L,P,'f),rr=nfmodpr(L,aa,mp));
    check(P[4]==1 && isprime(p),"certified degree-one rational prime");
    my(root=lift(rr.pol),rb=lift(Mod(root,p)^3),J=idealhnf(FL,p,x-rb));
    check(idealnorm(FL,J)==p,"literal contraction");
    my(ar=red(lo[5][1]*bnrisprincipal(lo[2],J,0),lo[6]),mult=sum(i=1,3,dd[i]));
    arts+=mult*ar;
    listput(rows,[p,root,rb,vv,dd,vector(3,i,ar[i]),mult]);
    listput(primes,[P,orb,J]);
  );
  check(idealdiv(L,nfgaloisapply(L,aut,D),D)==idealhnf(L,wa),"full ideal equation sigma(D)/D=(w)");
  my(ga=red(arts,lo[6]),CF=[1,-3,-3;0,1,0;1/3,-2/3,-2/3],CI=[-2,0,9;0,1,0;-1,-1,3],cd=[9,3,1],cl=red(CF*vector(3,i,ga[i])~,cd));
  check(CF*CI==matid(3) && CI*CF==matid(3),"exact class-coordinate inverse");
  my(qc=red(CF*vector(3,i,lo[7][i,1])~,cd),HD=mathnf(concat(matdiagonal(cd),qc)),defect=HD^-1*cl);
  check(cl==[0,1,0]~ && qc==[3,0,0]~ && defect==[0,1/3,0]~,"nonzero ordinary-unit norm class");
  my(c1=b+1+3*z,q3=idealprimedec(FL,3)[1],p17=idealprimedec(FL,17)[1]);
  check(idealhnf(FL,c1)==idealhnf(FL,q3) && idealval(FL,c1,p17)==0,"literal lower three-unit divisor");
  my(cu=subst(lift(c1),x,aa^3),L3=idealprimedec(L,3)[1],L17=idealprimedec(L,17)[1]);
  check(idealval(L,cu,L3)==3 && idealval(L,cu,L17)==0,"actual vertical valuation transfer");
  my(un=concat(BL.fu,[z]),mp17=nfmodprinit(FL,p17,'f),zr=nfmodpr(FL,z,mp17),unitres=vector(#un));
  for(i=1,#un,my(r=nfmodpr(FL,un[i],mp17),e=-1);for(j=0,2,if(r==zr^j,e=j));check(e>=0 && r^96==1,"all lower ordinary units are residue cubes");unitres[i]=e);
  emit("horizontal_witness_numerator",jmat(C));emit("horizontal_witness_denominator",den);
  emit("switched_witness",jpoly(wa,18));
  emit("support_orbits",Vec(rows));
  emit("genus_coordinate",Vec(ga));
  emit("class_forward",jmatq(CF));emit("class_inverse",jmat(CI));emit("class_orders",cd);
  emit("ideal_class",Vec(cl));emit("strongly_ambiguous_generator",Vec(qc));emit("strongly_ambiguous_lattice",jmat(HD));
  emit("defect_coordinate",vector(3,i,jfrac(defect[i])));
  emit("lower_unit_residue_exponents",unitres);
  emit("c1_lower_valuations",[1,0]);emit("c1_upper_valuations",[3,0]);
  emit("horizontal_S_class_norm",[[0],[1]]);
  writebin("research_e97/code/e_unit_norm_coset.bin",[BL,L,C,den,u,A,S,B,v,w,wa,fac,aut,D,Vec(primes),Vec(rows),ga,CF,CI,cl,qc,HD,defect,c1,unitres]);
  print("{\"type\":\"completion\",\"status\":\"PASS\",\"prime_orbits\":",#rows,",\"ordinary_unit_defect\":[0,1],\"xic1_S_unit_defect\":1}");
  print("DONE_EXACT_UNIT_NORM_COSET");
};
run();
quit;
