default(parisize,512000000);
default(parisizemax,2000000000);
default(realprecision,100);
check(a,s)=if(!a,error(s));
jstr(s)=Str("\"",s,"\"");
jpoly(v)=Str(vector(poldegree(lift(v))+1,i,Str(polcoef(lift(v),i-1))));
jmat(M)=Str(vector(matsize(M)[1],i,vector(matsize(M)[2],j,M[i,j])));
run()={
  my(data=read("research_prime17/frattini_field.bin"),F=data[1],R=data[2],P=F.pol);
  my(d=read("research_prime17/frattini_residues.bin"),U=d[1],D=d[2],M=d[3],D2=d[4],N=d[5]);
  my(z=rnfeltreltoabs(R,Mod(y,R.nf.pol)),r=rnfeltreltoabs(R,Mod(x,R.pol)),pi=U[9]);
  my(pr3=idealprimedec(F,3)[1],theta=Mod(x,P));
  check(r-z==theta,"primitive coordinate");
  my(images=[r-z^4,z^3*r-z,r-z^(-1)],acts=vector(3),names=["X","Y","C"]);
  for(k=1,3,
    my(A=matrix(10,10));
    for(j=1,10,
      my(v=subst(lift(U[j]),x,images[k]),e=idealval(F,v,pr3));
      my(w=bnfisunit(F,v/pi^e));
      check(#w==9,"transformed unit");
      for(i=1,8,A[i,j]=w[i]%3);
      A[9,j]=e%3; A[10,j]=w[9]%3;
    );
    acts[k]=A;
    print("ACTION_",names[k]," ",A);
  );
  my(X=Mod(acts[1],3),Y=Mod(acts[2],3),C=Mod(acts[3],3),I=matid(10));
  check(X^3==I && Y^3==I && X*Y==Y*X && C^2==I,"finite actions");
  check(C*X*C==X && C*Y*C==Y^(-1),"conjugation action");
  my(W=matker(matconcat([(X-I)^2;(X-I)*(Y-I);(Y-I)^2])));
  print("LOW_UNIT_SUBSPACE ",lift(W)," DIM ",matsize(W)[2]);
  my(Wminus=W*matker((C+I)*W));
  print("LOW_MINUS_UNIT_SUBSPACE ",lift(Wminus)," DIM ",matsize(Wminus)[2]);
  print("LOW_FROBENIUS17 ",lift(W~*Mod(M,3)));
  print("LOW_FROBENIUS2_CUBES ",lift(W~*Mod(N,3)));
  print("LOW_MINUS_FROBENIUS17 ",lift(Wminus~*Mod(M,3)));
  print("LOW_MINUS_FROBENIUS2_CUBES ",lift(Wminus~*Mod(N,3)));
  my(u=-z^2*(1-z)^2,su=-z^8*(1-z^4)^2,s2u=-z^14*(1-z^7)^2);
  check(u*su*s2u==3,"explicit Heisenberg norm");
  my(gamma=su*s2u^2,eg=idealval(F,gamma,pr3),ug=bnfisunit(F,gamma/pi^eg));
  my(gv=concat(concat(vector(8,i,ug[i]%3),[eg%3]),[ug[9]%3])~);
  print("HEISENBERG_RADICAND ",gamma," KUMMER_VECTOR ",gv);
  check(lift(gv~*Mod(N,3))==vector(3),"Frobenius cube central character");
  my(h=Mod(Wminus[,1]-Wminus[,2],3),w=(Y^(-1)-I)*h);
  my(k=if(w==Mod(gv,3),1,if(w==2*Mod(gv,3),2,0)));
  check(k!=0,"triple bracket dual character");
  print("TRIPLE_BRACKET_PAIRING ",k);
  print("FROBENIUS17_WORD_DEGREE3 x^6 [y,[x,y]]^",lift(Mod(2/k,3)));
  my(out="research_prime17/frattini_certificate.json");
  write(out,"{");
  write(out,"\"polynomial\":",jpoly(P),",");
  write(out,"\"zeta9\":",jpoly(z),",\"root3\":",jpoly(r),",");
  write(out,"\"units\":[",concat(vector(10,i,concat([if(i>1,",",""),jpoly(U[i])]))),"],");
  write(out,"\"integral_basis\":[",concat(vector(18,i,concat([if(i>1,",",""),jpoly(F.zk[i])]))),"],");
  write(out,"\"primes17\":[",concat(vector(#D,i,concat([if(i>1,",",""),jmat(idealhnf(F,D[i]))]))),"],");
  write(out,"\"primes2\":[",concat(vector(#D2,i,concat([if(i>1,",",""),jmat(idealhnf(F,D2[i]))]))),"],");
  write(out,"\"frobenius17\":",jmat(M),",\"frobenius2_cubes\":",jmat(N),",");
  write(out,"\"actions\":[",concat(vector(3,i,concat([if(i>1,",",""),jmat(acts[i])]))),"],");
  write(out,"\"low_units\":",jmat(lift(W)),",\"low_minus_units\":",jmat(lift(Wminus)),",");
  write(out,"\"heisenberg_radical\":",jpoly(gamma),",\"heisenberg_vector\":",Vec(gv),",\"triple_pairing\":",k);
  write(out,"}");
};
run();
quit;
