\\ Rebuild the exact arithmetic certificate; run from this file's directory.
default(parisize,512000000);
default(parisizemax,2000000000);
default(realprecision,100);
setrand(1702);
check(a,s)=if(!a,error(s));
jpoly(v)=Str(vector(poldegree(lift(v))+1,i,Str(polcoef(lift(v),i-1))));
jmat(M)=Str(vector(matsize(M)[1],i,vector(matsize(M)[2],j,M[i,j])));
run()={
  my(K=nfinit(y^6+y^3+1),R=rnfinit(K,x^3-3),P=R.polabs);
  my(F=bnfinit(P,1));
  check(bnfcertify(F)==1,"unconditional field certificate");
  check(F.cyc==[],"complete class number one");
  check(F.disc==-3^39,"exact discriminant");
  check(F.tu[1]==18,"complete root group");
  my(z=rnfeltreltoabs(R,Mod(y,K.pol)),r=rnfeltreltoabs(R,Mod(x,R.pol)));
  my(D3=idealprimedec(F,3));
  check(#D3==1 && D3[1][3]==18 && D3[1][4]==1,"unique totally ramified three-prime");
  my(pr3=D3[1],gg=bnfisprincipal(F,pr3,1),pi=nfbasistoalg(F,gg[2]));
  check(gg[1]==[]~,"actual three-prime generator");
  my(units=concat(concat(F.fu,[pi]),[z]));
  check(#units==10 && bnfisunit(F,z)[9]%3==1,"specified Kummer basis");
  print("CERTIFIED_FIELD ",P," CLASS ",F.cyc," DISCRIMINANT ",F.disc," ROOT_ORDER ",F.tu[1]);
  print("ZETA9 ",z," ROOT3 ",r," PRIME3_GENERATOR ",pi);
  print("FUNDAMENTAL_UNITS ",F.fu);
  my(D=idealprimedec(F,17),M=matrix(10,#D));
  check(#D==9,"nine actual Frattini primes");
  for(j=1,#D,
    my(mp=nfmodprinit(F,D[j]),rz=nfmodpr(F,z^3,mp));
    check(D[j][4]==2,"seventeen residue degree");
    for(i=1,10,M[i,j]=fflog(nfmodpr(F,units[i],mp)^96,rz));
    print("PRIME17 ",j," HNF ",idealhnf(F,D[j])," VECTOR ",M[,j]);
  );
  print("FROBENIUS_MATRIX ",M);
  print("FROBENIUS_RANK ",matrank(Mod(M,3)));
  print("FROBENIUS_RELATIONS ",lift(matker(Mod(M,3))));
  my(D2=idealprimedec(F,2),N=matrix(10,#D2));
  check(#D2==3,"three prime-two prolongations");
  for(j=1,#D2,
    my(mp=nfmodprinit(F,D2[j]),rz=nfmodpr(F,z^3,mp));
    check(D2[j][4]==6,"two residue degree");
    for(i=1,10,N[i,j]=fflog(nfmodpr(F,units[i],mp)^21,rz));
    print("PRIME2 ",j," HNF ",idealhnf(F,D2[j])," VECTOR ",N[,j]);
  );
  my(theta=Mod(x,P));
  check(r-z==theta,"literal primitive element");
  my(images=[r-z^4,z^3*r-z,r-z^(-1)],acts=vector(3),names=["X","Y","C"]);
  for(k=1,3,
    my(A=matrix(10,10));
    for(j=1,10,
      my(v=subst(lift(units[j]),x,images[k]),e=idealval(F,v,pr3));
      my(w=bnfisunit(F,v/pi^e));
      check(#w==9,"transformed S-unit");
      for(i=1,8,A[i,j]=w[i]%3);
      A[9,j]=e%3; A[10,j]=w[9]%3;
    );
    acts[k]=A;print("ACTION_",names[k]," ",A);
  );
  my(X=Mod(acts[1],3),Y=Mod(acts[2],3),C=Mod(acts[3],3),I=matid(10));
  check(X^3==I && Y^3==I && X*Y==Y*X && C^2==I,"finite actions");
  check(C*X*C==X && C*Y*C==Y^(-1),"exact conjugation action");
  my(W=matker(matconcat([(X-I)^2;(X-I)*(Y-I);(Y-I)^2])));
  my(Wminus=W*matker((C+I)*W));
  check(matsize(W)[2]==5 && matsize(Wminus)[2]==2,"low and conjugation-fixed dimensions");
  print("LOW_UNIT_SUBSPACE ",lift(W));
  print("LOW_MINUS_UNIT_SUBSPACE ",lift(Wminus));
  my(u=-z^2*(1-z)^2,u1=-z^8*(1-z^4)^2,u2=-z^14*(1-z^7)^2);
  check(u*u1*u2==3,"literal Heisenberg norm");
  my(gamma=u1*u2^2,q=(-2*z^5+2*z^4-z^2+z)/3);
  check((3-u^3)*gamma==9*q^3*(3-u1^3),"literal norm-cross-ratio identity");
  my(phi=(r-u)/(r-u1),phim=(z^6*r-u)/(z^6*r-u1),h=phi/phim);
  my(hYinv=subst(lift(h),x,z^6*r-z));
  check(hYinv/h==gamma*(phim/(r^2*q))^3,"literal triple-bracket radicand identity");
  check(subst(lift(h),x,r-z^(-1))==h^(-1),"exact conjugation of cross ratio");
  check(nfeltnorm(F,r-u)==3^10 && idealval(F,h,pr3)==0,"S-support and ordinary unit");
  my(eg=idealval(F,gamma,pr3),ug=bnfisunit(F,gamma/pi^eg),uh=bnfisunit(F,h));
  check(#uh==9,"cross-ratio unit");
  my(gv=concat(concat(vector(8,i,ug[i]%3),[eg%3]),[ug[9]%3])~);
  my(hv=concat(concat(vector(8,i,uh[i]%3),[0]),[uh[9]%3])~);
  check((Y^(-1)-I)*Mod(hv,3)==Mod(gv,3),"triple bracket pairing sign");
  check((X-I)^2*Mod(hv,3)==0 && (X-I)*(Y-I)*Mod(hv,3)==0 && (Y-I)^2*Mod(hv,3)==0,"cross ratio factors through D4");
  check(lift(gv~*Mod(N,3))==vector(3),"cube character of Heisenberg radicand");
  check(lift(hv~*Mod(N,3))==vector(3),"cross ratio vanishes on x-cubes");
  check(lift(hv~*Mod(M,3))==vector(9,i,2),"actual seventeen cross ratio");
  print("HEISENBERG_RADICAND ",gamma," VECTOR ",gv);
  print("CROSS_RATIO ",h," VECTOR ",hv);
  print("EXACT_NORM_ROOT ",q);
  print("DEGREE_THREE_WORD x^6 [y,[x,y]]^2 modulo D4");
  my(out="e_frattini17_certificate.json");
  fileclose(fileopen(out,"w"));
  write(out,"{");
  write(out,"\"polynomial\":",jpoly(P),",");
  write(out,"\"zeta9\":",jpoly(z),",\"root3\":",jpoly(r),",");
  write(out,"\"units\":[",concat(vector(10,i,concat([if(i>1,",",""),jpoly(units[i])]))),"],");
  write(out,"\"integral_basis\":[",concat(vector(18,i,concat([if(i>1,",",""),jpoly(F.zk[i])]))),"],");
  write(out,"\"primes17\":[",concat(vector(#D,i,concat([if(i>1,",",""),jmat(idealhnf(F,D[i]))]))),"],");
  write(out,"\"primes2\":[",concat(vector(#D2,i,concat([if(i>1,",",""),jmat(idealhnf(F,D2[i]))]))),"],");
  write(out,"\"frobenius17\":",jmat(M),",\"frobenius2_cubes\":",jmat(N),",");
  write(out,"\"actions\":[",concat(vector(3,i,concat([if(i>1,",",""),jmat(acts[i])]))),"],");
  write(out,"\"low_units\":",jmat(lift(W)),",\"low_minus_units\":",jmat(lift(Wminus)),",");
  write(out,"\"heisenberg_radical\":",jpoly(gamma),",\"heisenberg_vector\":",Vec(gv),",\"triple_pairing\":1,");
  write(out,"\"cross_ratio\":",jpoly(h),",\"cross_ratio_vector\":",Vec(hv),",\"norm_identity_root\":",jpoly(q));
  write(out,"}");
};
run();
quit;
