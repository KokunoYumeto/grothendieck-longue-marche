\\ Actual fifth-division field of y^2=x^3+x and its class group.
\\ All field embeddings below are retained in the binary certificate.
default(parisize,256000000);
default(parisizemax,2000000000);
default(realprecision,96);
P=x^8+2*x^4+5;
Q=x^4-5;
print("{\"stage\":\"input\",\"P\":\"",P,"\",\"Q\":\"",Q,"\"}");
cc=polcompositum(P,Q,1);
print("{\"stage\":\"composita\",\"number\":",#cc,",\"degrees\":",vector(#cc,j,poldegree(cc[j][1])),"}");
if(#cc!=1 || poldegree(cc[1][1])!=32,error("unexpected compositum degree"));
C=cc[1];
R=C[1]; a=C[2]; t=C[3]; b=t/a;
ii=-(a^4+1)/2;
if(ii^2!=-1 || a^4!=-1-2*ii || b^4!=-1+2*ii,error("literal field identities"));
yp=(1+ii)/(2-ii)*a;
xp=yp^2/((4+2*ii)/5);
ym=(1-ii)/(2+ii)*b;
xm=ym^2/((4-2*ii)/5);
if(yp^2!=xp^3+xp || ym^2!=xm^3+xm,error("point equation"));
EE=ellinit([0,0,0,1,0]);
PP=[xp,yp]; PM=[xm,ym];
if(ellmul(EE,PP,5)!=[0] || ellmul(EE,PM,5)!=[0],error("fifth torsion"));
if(ellmul(EE,PP,2)!=[-xp,ii*yp],error("positive CM eigenspace"));
if(ellmul(EE,PM,2)!=[-xm,-ii*ym],error("negative CM eigenspace"));
print("{\"stage\":\"literal_curve_maps\",\"all_identities\":true,\"degree\":32}");
red=polredbest(R,1);
RR=red[1]; old=red[2];
aa=subst(lift(a),x,old); bb=subst(lift(b),x,old); tt=subst(lift(t),x,old); iii=subst(lift(ii),x,old);
if(aa^4!=-1-2*iii || bb^4!=-1+2*iii || tt^4!=5 || iii^2!=-1,error("reduced maps"));
print("{\"stage\":\"reduced_polynomial\",\"polynomial\":\"",RR,"\"}");
B=bnfinit(RR,1);
print("{\"stage\":\"bnf_computed\",\"class_number\":",B.no,",\"class_invariants\":",B.cyc,",\"discriminant\":\"",B.disc,"\"}");
cert=bnfcertify(B);
if(cert!=1,error("unconditional BNF certification failed"));
pr2=idealprimedec(B,2); pr5=idealprimedec(B,5);
print("{\"stage\":\"certified\",\"certificate\":",cert,",\"class_number\":",B.no,",\"class_invariants\":",B.cyc,",\"prime2_ef\":",vector(#pr2,j,[pr2[j].e,pr2[j].f]),",\"prime5_ef\":",vector(#pr5,j,[pr5[j].e,pr5[j].f]),"}");
writebin("research_e112/code/quartic_five_division_field.bin",[B,aa,bb,tt,iii,pr2,pr5,C,red]);
print("{\"stage\":\"completion\",\"status\":\"PASS\"}");
quit(0);
