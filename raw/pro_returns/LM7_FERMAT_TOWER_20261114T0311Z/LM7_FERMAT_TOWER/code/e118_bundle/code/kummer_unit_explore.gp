\\ Actual mod-five Kummer eigenunit in the E.112 character field.
default(parisize,128000000);
default(parisizemax,1000000000);
default(realprecision,96);
check(c,m)=if(!c,error(m));
{
 my(D=read("research_e112/code/quartic_five_character_fields.bin"));
 my(B=D[2][3],b=Mod(x,B.pol),ii=(b^4+1)/2,F=B.fu);
 check(D[2][1]==1 && D[2][2]==[0,1],"actual character field index");
 check(B.pol==x^8+2*x^4+5 && ii^2==-1,"actual b field");
 check(D[2][6]==1 && B.no==1,"retained complete class certificate");
 my(tau=ii*b,logs=vector(3,j,bnfisunit(B,subst(lift(F[j]),x,tau))));
 check(subst(lift(ii),x,tau)==ii,"tau fixes i");
 my(M=matrix(3,3,i,j,logs[j][i]));
 check(M^4==matid(3),"unit action order four");
 my(K=matker(Mod(M-3*matid(3),5)));
 check(matsize(K)==[3,1],"one-dimensional character-three eigenspace");
 my(v=lift(K[,1]),u=prod(j=1,3,F[j]^v[j]),ratio=subst(lift(u),x,tau)/u^3,rv=bnfisunit(B,ratio));
 check(#rv==4 && sum(j=1,3,rv[j]%5==0)==3,"literal fifth-power unit ratio");
 my(w=prod(j=1,3,F[j]^(rv[j]/5))*B.tu[2]^lift(Mod(5,B.tu[1])^-1*rv[4]));
 check(w^5==ratio,"tau(u)=w^5 u^3");
 print("FIELD ",B.pol);
 print("UNIT_ACTION ",M);
 print("EIGENVECTOR ",v);
 print("UNIT ",lift(u));
 print("FIFTH_POWER_CORRECTION ",lift(w));
 print("RATIO_UNIT_COORDINATES ",rv);
 my(found=0);
 forprime(p=7,1000000,
  if(p%40!=1 || (p-1)%25==0,next);
  if(Mod(2,p)^((p-1)/5)!=1,next);
  my(rootsi=polrootsmod(x^2+1,p),ip=rootsi[1]);
  my(ra=polrootsmod(x^4+1+2*ip,p),rb=polrootsmod(x^4+1-2*ip,p));
  if(#ra!=4 || #rb!=4,next);
  my(ap=ra[1],bp=rb[1],up=subst(lift(u),x,bp),ucp=subst(lift(u),x,ap));
  if(up^((p-1)/5)==1,next);
  my(EC=ellinit([0,0,0,1,0],p),n=ellcard(EC));
  if(valuation(n,5)!=2,next);
  my(yp=(1+ip)/(2-ip)*ap,ym=(1-ip)/(2+ip)*bp);
  my(PP=[yp^2/((4+2*ip)/5),yp],PM=[ym^2/((4-2*ip)/5),ym]);
  check(ellisoncurve(EC,PP) && ellisoncurve(EC,PM),"actual specialized torsion points");
  check(ellmul(EC,PP,5)==[0] && ellmul(EC,PM,5)==[0],"actual specialized fifth torsion");
  my(eta=ellweilpairing(EC,PP,PM,5),z=up^((p-1)/5),zc=ucp^((p-1)/5));
  check(eta!=1 && eta^5==1,"actual primitive Weil pairing");
  my(e=znlog(z,eta,5),ec=znlog(zc,eta,5));
  print("PRIME ",p);
  print("ROOTS_I_A_B ",[lift(ip),lift(ap),lift(bp)]);
  print("ELLIPTIC_ORDER ",n);
  print("WEIL_PAIRING ",lift(eta));
  print("UNIT_VALUES ",[lift(up),lift(ucp)]);
  print("FIFTH_RESIDUES ",[lift(z),lift(zc)]);
  print("COCYCLE_COORDINATES ",[e,lift(Mod(-ec,5))]);
  print("POINTS ",[lift(PP),lift(PM)]);
  found=1;break;
 );
 check(found,"numerical mixed witness found");
 writebin("research_e118/code/kummer_unit_explore.bin",[B,M,v,u,w]);
 print("PASS actual Kummer unit and numerical mixed witness");
}
quit(0);
