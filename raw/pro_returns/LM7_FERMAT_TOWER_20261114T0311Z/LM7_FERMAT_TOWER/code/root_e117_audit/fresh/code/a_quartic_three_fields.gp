\\ Actual full third-division fields; all class groups certified with flag0.
default(parisize,128000000);
default(parisizemax,2000000000);
default(realprecision,96);
check(c,m)={if(!c,print("FAILED: ",m);quit(1));};
coords(z,n)={my(p=lift(z));vector(n,k,Str(polcoef(p,k-1)));};
rows(M)={vector(matsize(M)[1],i,vector(matsize(M)[2],j,Str(M[i,j])));};
applymap(z,w)={subst(lift(z),x,w);};
compose(u,v)={subst(lift(u),x,v);};
allcert=List();
{
for(case=1,2,
 A=if(case==1,1,4);
 P=x^8+216*A^3*x^4-3888*A^6;
 cs=polcompositum(P,x^2+1,1);
 check(#cs==1 && poldegree(cs[1][1])==16,"single degree16 compositum");
 cc=cs[1]; red=polredabs(cc[1],1); Q=red[1]; thetaold=red[2]; thgen=Mod(x,Q);
 check(polisirreducible(Q) && subst(cc[1],x,thetaold)==0,"reduced field inclusion");
 aa=applymap(cc[2],thetaold); ii=applymap(cc[3],thetaold);
 check(aa^8+216*A^3*aa^4-3888*A^6==0 && ii^2==-1,"literal radicals");
 check(thetaold==ii+cc[4]*aa,"primitive source map");
 MM=matrix(16,16,r,s,polcoef(lift(thetaold^(s-1)),r-1)); NN=MM^-1;
 check(MM*NN==matid(16) && NN*MM==matid(16),"two-way power-basis map");
 back=sum(k=1,16,NN[k,2]*x^(k-1));
 check(subst(back,x,thetaold)==thgen,"actual inverse primitive map");
 YY=aa/3; XX=12*A^2*aa^2/(aa^4+108*A^3); PP=[XX,YY]; IP=[-XX,ii*YY];
 EC=ellinit([0,0,0,A,0]);
 check(ellisoncurve(EC,PP) && ellisoncurve(EC,IP),"actual elliptic points");
 check(ellmul(EC,PP,3)==[0] && ellmul(EC,IP,3)==[0],"third torsion");
 check(ellmul(EC,PP,2)==[XX,-YY],"duplication is negation");
 pts=vector(9,k,elladd(EC,ellmul(EC,PP,(k-1)%3),ellmul(EC,IP,(k-1)\3)));
 check(#Set(pts)==9,"full E[3] point basis");
 rt3=(3*XX^2+3*A)/(2*A); zz=(-1+ii*rt3)/2;
 check(rt3^2==3 && zz^2+zz+1==0 && zz!=1,"literal primitive cube root");
 slope=(3*XX^2+A)/(2*YY);
 wp=-((ii-1)*YY+2*slope*XX)/((1-ii)*YY+2*ii*slope*XX);
 check(wp^3==1 && wp!=1,"normalized flex-line Weil value");
 check(wp==zz || wp==zz^2,"literal primitive Weil pairing");
 we=if(wp==zz,1,2);
 TP=elladd(EC,PP,IP); at=3*TP[2];
 tau=subst(back,x,ii+cc[4]*at); gconj=subst(back,x,-ii+cc[4]*aa);
 check(subst(Q,x,tau)==0 && subst(Q,x,gconj)==0,"actual field automorphisms");
 check(applymap(aa,tau)==at && applymap(ii,tau)==ii,"CM generator action");
 check(applymap(aa,gconj)==aa && applymap(ii,gconj)==-ii,"real-point conjugation");
 autpow=vector(8,k,0); autpow[1]=thgen;
 for(k=2,8,autpow[k]=compose(autpow[k-1],tau));
 check(compose(autpow[8],tau)==thgen && #Set(autpow)==8,"order8 actual CM automorphism");
 check(compose(gconj,gconj)==thgen,"order2 conjugation");
 check(compose(compose(gconj,tau),gconj)==autpow[4],"c tau c equals tau cubed");
 auts=concat(autpow,vector(8,k,compose(autpow[k],gconj)));
 check(#Set(auts)==16,"full16 field automorphisms");
 check(applymap(zz,tau)==zz^2 && applymap(zz,gconj)==zz^2,"actual cyclotomic determinant");
 for(k=1,16,check(subst(Q,x,auts[k])==0,"all automorphisms preserve polynomial"));
 BB=bnfinit(Q,1); ce=bnfcertify(BB);
 check(ce==1 && BB.no==1,"full unconditional class number1");
 pr2=idealprimedec(BB,2);pr3=idealprimedec(BB,3);
 check(#pr2==1 && #pr3==1,"unique primes2and3");
 check(pr2[1].e==8 && pr2[1].f==2 && pr3[1].e==8 && pr3[1].f==2,"literal local decomposition orders");
 dd=factor(abs(BB.disc));check(dd[,1]==[2,3]~,"no other ramified prime");
 print("{\"stage\":\"actual_three_field\",\"case\":",case,",\"curve_a4\":",A,",\"point_radical_polynomial\":",coords(P,9),",\"polynomial\":",coords(Q,17),",\"degree\":16,\"discriminant\":\"",BB.disc,"\",\"discriminant_factorization\":",vector(matsize(dd)[1],k,[dd[k,1],dd[k,2]]),",\"class_number\":",BB.no,",\"class_invariants\":",BB.cyc,",\"certify_flag\":0,\"certify_return\":",ce,",\"prime2_ef\":",vector(#pr2,k,[pr2[k].e,pr2[k].f]),",\"prime3_ef\":",vector(#pr3,k,[pr3[k].e,pr3[k].f]),",\"a\":",coords(aa,16),",\"i\":",coords(ii,16),",\"point_x\":",coords(XX,16),",\"point_y\":",coords(YY,16),",\"zeta3\":",coords(zz,16),",\"tau\":",coords(tau,16),",\"conjugation\":",coords(gconj,16),",\"source_primitive\":",coords(thetaold,16),",\"source_inverse\":",coords(back,16),",\"source_power_basis\":",rows(MM),",\"source_power_basis_inverse\":",rows(NN),",\"Weil_pairing_zeta_exponent\":",we,",\"torsion_points\":9,\"automorphisms\":16,\"automorphism_polynomials\":",vector(16,k,coords(auts[k],16)),",\"source_primitive_coefficient\":",cc[4],",\"literal_maps_verified\":true}");
 listput(allcert,[case,A,P,cc,red,aa,ii,PP,IP,zz,tau,gconj,MM,NN,back,BB,ce,pr2,pr3,auts,wp,we]);
);
}
check(#allcert==2,"both actual division fields");
writebin("research_e117/code/a_quartic_three_fields.bin",Vec(allcert));
print("{\"stage\":\"completion\",\"status\":\"PASS\",\"certified_fields\":2}");
quit(0);
