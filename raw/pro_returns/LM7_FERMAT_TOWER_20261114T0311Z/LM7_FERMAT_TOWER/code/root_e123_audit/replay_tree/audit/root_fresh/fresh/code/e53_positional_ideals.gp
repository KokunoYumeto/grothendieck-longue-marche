check(idealhnf(L,A)==idealdiv(L,J,idealfactorback(L,LG,[2,2]~)),"lower full pivot identity");
check(nfisideal(L,J) && idealnorm(L,J)==103 && idealadd(L,J,beta-90)==J,"literal lower prime and chosen residue");
