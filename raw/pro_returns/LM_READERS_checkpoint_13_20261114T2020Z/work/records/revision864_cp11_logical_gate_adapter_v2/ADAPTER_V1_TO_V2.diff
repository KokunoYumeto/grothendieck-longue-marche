+class ImageLookup:
+    """Only the collector's explicitly qualified proof-image namespace map."""
+    def __init__(self, root, qualification, original_qualification):
+        self.root = root
+        self.qualification = qualification
+        rows = qualification['rows']
+        self.allowed = {row['preserved_path']: row for row in rows}
+        require(len(rows) == len(self.allowed) == 3764 and
+                len({row['snapshot_image_index'] for row in rows}) == 3764,
+                'Image authority must contain exactly3764 unique names/indices')
+        self.used = set(); self.seen = set(); self.blobs = set(); self.recipe_ids = set(); self.direct = 0
+        for label, ref in qualification['inputs'].items():
+            require(digest(root / ref['path']) == ref['sha256'] and
+                    (root / ref['path']).stat().st_size == ref['bytes'], 'Image authority input changed: ' + label)
+        require(qualification['inputs']['archive'] == original_qualification['inputs']['archive'] and
+                qualification['inputs']['snapshot'] == original_qualification['inputs']['snapshot'] and
+                qualification['inputs']['full_recovery'] == original_qualification['inputs']['full_recovery'],
+                'Image authority belongs to different checkpoint/snapshot/recovery')
+        raw_recovery = json.loads((root / qualification['inputs']['raw_recovery']['path']).read_bytes())
+        recovery = json.loads((root / qualification['inputs']['full_recovery']['path']).read_bytes())
+        require(recovery['restore_report_sha256'] == qualification['inputs']['raw_recovery']['sha256'] and
+                raw_recovery['status'] == 'PASS' and raw_recovery['failures'] == [] and
+                raw_recovery['complete_logical_recovery'] is True and raw_recovery['physical_zip_manifest_verified'] is True and
+                raw_recovery['verified_logical_count'] == 75238 and raw_recovery['verified_recipe_count'] == 12146,
+                'Image recipes lack the exact complete restored-byte authority')
+        self.snapshot = json.loads((root / SNAPSHOT).read_bytes())
+        with zipfile.ZipFile(root / ARCHIVE) as container:
+            descriptor = json.loads(container.read('COMPACT_CHECKPOINT.json'))
+            inventories = {}
+            for key in ('logical_manifest', 'alias_inventory', 'png_recipes'):
+                ref = qualification['archive_controls'][key]
+                require(descriptor[key] == ref, 'Image inventory descriptor differs: ' + key)
+                data = container.read(ref['path'])
+                require((sha(data), len(data)) == (ref['sha256'], ref['bytes']), 'Image inventory bytes differ: ' + key)
+                inventories[key] = data
+            logical_rows = list(csv.DictReader(io.StringIO(inventories['logical_manifest'].decode()), delimiter='\t'))
+            logical = {row['path']: row for row in logical_rows}
+            require(len(logical) == len(logical_rows) == 75238, 'Logical inventory scope differs')
+            self.aliases = {row['alias_path']: row for row in csv.DictReader(io.StringIO(inventories['alias_inventory'].decode()), delimiter='\t')}
+            self.recipes = {row['id']: row for row in json.loads(inventories['png_recipes'])['recipes']}
+            require(len(self.recipes) == 12146, 'Recipe inventory coverage differs')
+            # Exhaustively resolve every original gate logical-path expression.
+            require(SNAPSHOT in logical and logical[SNAPSHOT]['sha256'] == SNAPSHOT_SHA, 'Snapshot itself is not archived')
+            require(all(name in logical for name in ('work/records/CHECKPOINT_STATUS.json',
+                    'work/records/checkpoint_archives.jsonl', 'work/records/CHECKPOINT_SAVES.tsv')), 'Missing bookkeeping logical path')
+            require({row['original_path'] for row in self.snapshot['files'] if row['original_path'] not in logical} ==
+                    {row['original_path'] for row in original_qualification['rows']}, 'Absent file-original scope differs')
+            require(all(row['snapshot_path'] in logical and
+                    (logical[row['snapshot_path']]['sha256'], int(logical[row['snapshot_path']]['bytes'])) ==
+                    (row['snapshot_sha256'], row['snapshot_bytes']) for row in self.snapshot['files']),
+                    'A captured-file logical path is missing or changed')
+            require(len(self.snapshot['pdfs']) == 7 and all(row['path'] in logical and
+                    logical[row['path']]['sha256'] == row['sha256'] for row in self.snapshot['pdfs']), 'A PDF logical path is missing or changed')
+            require(len(self.snapshot['images']) == 11891 and
+                    {row['preserved_path'] for row in self.snapshot['images'] if row['preserved_path'] not in logical} == set(self.allowed),
+                    'Absent image scope differs')
+            for index, row in enumerate(self.snapshot['images']):
+                name = row['preserved_path']
+                if name in logical:
+                    require(logical[name]['sha256'] == row['sha256'], 'Present image logical identity differs: ' + name)
+                else:
+                    self.describe(logical, row, index)
+        self.preflight = dict(status='PASS', snapshot_documents=1, bookkeeping_paths=3,
+            file_original_paths=3133, qualified_absent_file_originals=950, captured_file_paths=3133,
+            pdf_paths=7, image_paths=11891, direct_image_paths=8127, qualified_image_paths=3764,
+            unclassified_missing_names=0, png_recipe_executions=0)
+
+    def describe(self, logical, row, index):
+        name = row['preserved_path']
+        require(name in self.allowed and name.startswith('work/visual_repair_proofs/'), 'Unqualified absent image name: ' + name)
+        approved = self.allowed[name]
+        require(index == approved['snapshot_image_index'] and canonical_sha(row) == approved['snapshot_image_record_sha256'],
+                'Snapshot image row/index differs: ' + name)
+        mapped = 'proofs/visual_repairs/' + name[len('work/visual_repair_proofs/'):]
+        require(mapped == approved['archive_logical_path'] and mapped in logical, 'Exact collector image path is absent: ' + name)
+        entry = logical[mapped]
+        require(canonical_sha(entry) == approved['logical_row_sha256'] and
+                (entry['sha256'], int(entry['bytes'])) == (row['sha256'], approved['bytes']), 'Mapped image logical identity differs: ' + name)
+        target = logical[entry['target_path']] if entry['storage_kind'] == 'alias' else entry
+        require(target['path'] == approved['canonical_logical_path'] and canonical_sha(target) == approved['canonical_row_sha256'] and
+                target['storage_kind'] in {'blob', 'png_recipe'} and
+                (target['sha256'], int(target['bytes'])) == (row['sha256'], approved['bytes']), 'Image canonical payload differs: ' + name)
+        if entry['storage_kind'] == 'alias':
+            require(canonical_sha(self.aliases[mapped]) == approved['alias_record_sha256'] and
+                    self.aliases[mapped]['target_path'] == target['path'], 'Image alias authority differs: ' + name)
+        if target['storage_kind'] == 'png_recipe':
+            recipe = self.recipes[target['recipe_id']]
+            require(recipe['id'] == approved['recipe_id'] and canonical_sha(recipe) == approved['recipe_record_sha256'] and
+                    (recipe['expected']['png_sha256'], recipe['expected']['bytes']) == (row['sha256'], approved['bytes']),
+                    'Image recipe identity differs: ' + name)
+        else:
+            require(target['object_path'] == approved['archive_object_path'], 'Image primitive object differs: ' + name)
+        return approved, target
+
+    def __call__(self, container, logical, row, index):
+        name = row['preserved_path']
+        require(index not in self.seen, 'Snapshot image checked twice')
+        self.seen.add(index)
+        if name in logical:
+            require(name not in self.allowed and logical[name]['sha256'] == row['sha256'], 'Present image identity differs: ' + name)
+            require((self.root / name).stat().st_size == int(logical[name]['bytes']), 'Present image byte count differs: ' + name)
+            self.direct += 1
+            return
+        approved, target = self.describe(logical, row, index)
+        require((self.root / name).stat().st_size == approved['bytes'], 'Current mapped image byte count differs: ' + name)
+        if target['storage_kind'] == 'blob':
+            key = (target['object_path'], row['sha256'], approved['bytes'])
+            if key not in self.blobs:
+                info = container.getinfo(target['object_path'])
+                require(info.file_size == approved['bytes'] and not info.flag_bits & 1, 'Image primitive ZIP header differs: ' + name)
+                data = container.read(target['object_path'])
+                require((sha(data), len(data)) == (row['sha256'], approved['bytes']), 'Image primitive bytes differ: ' + name)
+                self.blobs.add(key)
+        else:
+            # The pinned complete75238-file/12146-recipe recovery already
+            # verified these exact output bytes. No rendering is inferred here.
+            self.recipe_ids.add(target['recipe_id'])
+        self.used.add(name)
+
+
+def canonical_sha(value):
+    return sha(json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode())
+
