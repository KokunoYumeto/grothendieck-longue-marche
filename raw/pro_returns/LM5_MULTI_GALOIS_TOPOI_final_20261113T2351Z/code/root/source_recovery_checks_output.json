  "literal_register_rows": [
    {
      "id": "B5",
      "statement": "Slimness passes through profinite extensions and surjective inverse limits; nonabelian finite-rank free profinite factors have it; the unqualified free-group corollary is false at rank one.",
      "status": "Proved",
      "where_proved": "CYCLOTOMIC_KERNEL_paper.tex; res:B5",
      "depends_on": "Nakamura Corollary (1.3.4)",
      "manuscript_passages (section; page; scan)": "section 1; pp.6-7; scans 13-15",
      "depends_on_doubtful_reading (scan, alternatives)": "scan 15 free-group rank omission",
      "notes": "Explicit maps and transfer proof. Torsion-freeness derived from finite graph covers and abelianization. All three marginal checks identified."
    },
    {
      "id": "C8",
      "statement": "Boundary-local sections of elementary hyperbolic polycurves have nonzero cyclotomic centralizer. Local inertia injectivity fails after a blowup, with map(m,n)->m+n.",
      "status": "Proved",
      "where_proved": "CYCLOTOMIC_KERNEL_paper.tex; res:C8",
      "depends_on": "B_Hoshi2014 Lemma2.8,Prop2.4;C5;local Kummer covers",
      "manuscript_passages (section; page; scan)": "4;63–65;128–131",
      "depends_on_doubtful_reading (scan, alternatives)": "130: injectivity claim explicitly withdrawn;131: geometric target subscript",
      "notes": "The converse requires a boundary-local factorization; its product case already forces curve section surjectivity. Exact blowup matrix checks attached."
    }
  ],
