default(parisizemax,1000000000);default(parisize,64000000);
pp=(1)*x^18+(-9)*x^17+(36)*x^16+(-69)*x^15+(360)*x^13+(-993)*x^12+(1287)*x^11+(-225)*x^10+(-2557)*x^9+(5886)*x^8+(-7713)*x^7+(6960)*x^6+(-4473)*x^5+(2007)*x^4+(-588)*x^3+(99)*x^2+(-9)*x^1+(1)*x^0;
aa=Mod((10915/65773)*x^0+(32382/65773)*x^1+(6203909/65773)*x^2+(-38619021/65773)*x^3+(115934824/65773)*x^4+(-216311076/65773)*x^5+(272263624/65773)*x^6+(-230745446/65773)*x^7+(2159385/1241)*x^8+(-2446918/65773)*x^9+(-47210301/65773)*x^10+(39868214/65773)*x^11+(-208159/901)*x^12+(295387/65773)*x^13+(2725428/65773)*x^14+(-1430497/65773)*x^15+(351136/65773)*x^16+(-37200/65773)*x^17,pp);
zz=Mod((-1134774/65773)*x^0+(8624481/65773)*x^1+(-104425087/65773)*x^2+(7470539/901)*x^3+(-1580140968/65773)*x^4+(2972590763/65773)*x^5+(-3849221223/65773)*x^6+(3426457260/65773)*x^7+(-35385969/1241)*x^8+(230065198/65773)*x^9+(616824027/65773)*x^10+(-609581851/65773)*x^11+(268545472/65773)*x^12+(-25707651/65773)*x^13+(-38677360/65773)*x^14+(24173964/65773)*x^15+(-6619521/65773)*x^16+(795459/65773)*x^17,pp);
nn=nfinit([pp,[3]]);if(nfcertify(nn)!=[],error("basis"));
ee1=((3)*aa^0*zz^1)/3;
ee3=((-1)*aa^2*zz^1+(1)*aa^2*zz^2+(1)*aa^2*zz^3+(-1)*aa^2*zz^4)/3;
ee5=((-1)*aa^0*zz^0+(2)*aa^0*zz^1+(2)*aa^0*zz^2+(-2)*aa^0*zz^3+(1)*aa^0*zz^4+(1)*aa^0*zz^5+(2)*aa^1*zz^1+(1)*aa^1*zz^4)/3;
ee6=((-1)*aa^0*zz^1+(-2)*aa^0*zz^2+(-2)*aa^0*zz^4+(-1)*aa^0*zz^5+(1)*aa^1*zz^0+(1)*aa^1*zz^1+(1)*aa^1*zz^2+(-1)*aa^2*zz^0+(-1)*aa^2*zz^3+(1)*aa^2*zz^4)/3;
ee8=((-2)*aa^0*zz^0+(-1)*aa^0*zz^2+(-1)*aa^0*zz^3+(-2)*aa^0*zz^5+(-1)*aa^1*zz^0+(1)*aa^1*zz^1+(-1)*aa^1*zz^2+(-1)*aa^1*zz^3+(-1)*aa^1*zz^5+(-1)*aa^2*zz^0)/3;
ee9=((1)*aa^0*zz^0+(2)*aa^0*zz^1+(2)*aa^0*zz^3+(1)*aa^0*zz^4+(1)*aa^1*zz^0+(-1)*aa^1*zz^1+(1)*aa^1*zz^2+(1)*aa^1*zz^3+(1)*aa^1*zz^5+(-1)*aa^2*zz^2+(-1)*aa^2*zz^5)/3;
kk=ee1/ee3*ee5/ee6*ee8/ee9;qq=(aa^2-2)/aa*kk;yy=varhigher("Y",'x);rr=nfroots(nn,yy^3-qq);print("ROOT_COUNT ",#rr);
if(#rr,cc=rr[1];if(cc^3!=qq,error("cube"));mm=vector(18,j,aa^((j-1)\6)*zz^((j-1)%6));mt=matrix(18,18,i,j,polcoef(lift(mm[j]),i-1));cv=matsolve(mt,vector(18,i,polcoef(lift(cc),i-1))~);print("NATURAL_ROOT ",Vec(cv)));
quit;
