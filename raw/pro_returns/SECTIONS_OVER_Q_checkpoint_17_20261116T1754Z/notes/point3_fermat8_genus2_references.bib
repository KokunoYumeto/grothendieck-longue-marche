@article{LegStollDescent2001,
 author={Stoll, Michael},
 title={Implementing 2-descent for Jacobians of hyperelliptic curves},
 journal={Acta Arithmetica},
 volume={98}, number={3}, pages={245--277}, year={2001},
 doi={10.4064/aa98-3-4},
 url={https://www.impan.pl/shop/publication/transaction/download/product/83397},
 note={Verified: original publisher PDF opened. Lemma 4.1 and Proposition 4.2 (p.250) identify the odd-degree norm-kernel and true finite Kummer/Selmer maps; Lemma 4.3 (pp.250--251) supplies the point, branch-divisor, and rational two-torsion formulas; Proposition 4.6 and Corollary 4.7 (pp.252--253) give the exact outside-support valuation condition. A.186 uses its own literal algebra and complete certified arithmetic.}
}
@article{LegPoonenRains2012,
 author={Poonen, Bjorn and Rains, Eric},
 title={Random maximal isotropic subspaces and Selmer groups},
 journal={Journal of the American Mathematical Society},
 volume={25}, number={1}, pages={245--269}, year={2012},
 doi={10.1090/S0894-0347-2011-00710-8},
 url={https://math.mit.edu/~poonen/papers/selmer.pdf},
 note={Verified: author PDF dated 17 May 2011, with minor correction 6 August 2012, opened. Section 4.1, Remark 4.5 and Corollary 4.7 identify the quadratic-form polarization with the Weil-cup pairing; Proposition 4.9 (author p.17) and Proposition 4.11 (author p.18) prove Kummer isotropy and the local maximal-isotropic assertion. A.186 applies these to the literal rational symmetric theta divisor and twice its principal polarization.}
}
@misc{LegPariNumberFields,
