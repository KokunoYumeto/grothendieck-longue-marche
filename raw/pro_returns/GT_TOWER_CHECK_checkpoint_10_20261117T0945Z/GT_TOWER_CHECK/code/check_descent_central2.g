# Exact central-C2 quotients of the canonical relative B-central cover.
DESCENT_CONTINUE:=true;
Read("work/centralizer_code/check_descent_source_frames.g");
Print("Starting PC H2(D,F2) at runtime ",Runtime(),".\n");
pd:=Pcgs(pcD);nd:=Length(pd);
trivial2:=GModuleByMats(List(pd,g->IdentityMat(1,GF(2))),GF(2));
coh2:=TwoCohomology(pcD,trivial2);
hbasis:=BasisVectors(Basis(Range(coh2.cohom)));
cocycles:=List(hbasis,v->PreImagesRepresentative(coh2.cohom,v));
Print("H2 dimension: ",Length(cocycles),"; PC length: ",nd,"; runtime ",Runtime(),".\n");
SourceLift:=function(E,g)
 return MappedPcElement(g,pd,Pcgs(E){[1..nd]});
end;
sbits:=[];
for i in [1..Length(cocycles)] do
 cen:=Extension(pcD,trivial2,cocycles[i]);se:=SourceLift(cen,ssD);
 if se^2=One(cen) then Add(sbits,0);else Add(sbits,1);fi;
od;
Print("Restriction to <s> bits: ",sbits,"\n");
bad:=Position(sbits,1);allowed:=[];
for i in [1..Length(cocycles)] do
 if i=bad then continue;fi;
 v:=cocycles[i];if sbits[i]=1 then v:=v+cocycles[bad];fi;
 Add(allowed,v);
od;
Print("Canonical central-C2 quotient basis dimension: ",Length(allowed),"\n");
survCentral:=List(sourceCandidates,r->true);records:=[];
for j in [1..Length(allowed)] do
 cen:=Extension(pcD,trivial2,allowed[j]);ce:=Pcgs(cen)[nd+1];
 se:=SourceLift(cen,ssD);re:=SourceLift(cen,rrD);
 if re^3<>One(cen) then re:=re*ce;fi;
 if se^2<>One(cen) or re^3<>One(cen) then Error("B generators missing");fi;
 if Size(Group(se,re))<>Size(cen) then Error("canonical central quotient not generated by B");fi;
 for i in [1..Length(sourceCandidates)] do
  cand:=sourceCandidates[i];fe:=SourceLift(cen,Image(isoD,cand.f));
  aa:=(se*fe)^2;bb:=(fe^-1*re)^3;
  obstruction:=aa^3*bb^2;
  if obstruction<>One(cen) then
   passCycle:=false;passFrame:=false;
  else
   passCycle:=true;fe:=fe*aa*bb;
   if (se*fe)^2<>One(cen) or (fe^-1*re)^3<>One(cen) then Error("central correction failed");fi;
   passFrame:=IsConjugate(cen,se,se*fe) and IsConjugate(cen,re,fe^-1*re);
  fi;
  if not passFrame then survCentral[i]:=false;fi;
  Add(records,[j,i,cand.bit,passCycle,passFrame]);
 od;
 Print("Central basis ",j,": surviving candidates ",Filtered([1..Length(sourceCandidates)],i->survCentral[i]),"; runtime ",Runtime(),".\n");
od;
Print("CENTRAL REFINEMENT RECORDS [basis,candidate,Delta,cycle lift,positive frames]: ",records,"\n");
Print("FINAL CENTRAL-C2 SURVIVORS: ",Filtered([1..Length(sourceCandidates)],i->survCentral[i]),"\n");
Print("Exact necessary central quotient test only; no full lift inferred.\n");
QUIT_GAP(0);
