# Actual source A4 is adjoined to the complete PC50 finite detector.
Read("work/centralizer_code/small_homology_replay_2_full.g");;
BuildReplayPC:=function(dat)
 local n,fg,g,coll,word,i,rel;
 n:=Length(dat[1]);fg:=FreeGroup(n);g:=GeneratorsOfGroup(fg);
 coll:=SingleCollector(g,dat[1]);word:=v->Product([1..n],j->g[j]^v[j]);
 for i in [1..n] do SetPower(coll,i,word(dat[2][i]));od;
 for rel in dat[3] do SetConjugate(coll,rel[1],rel[2],word(rel[3]));od;
 return GroupByRws(coll);
end;;
baseR:=BuildReplayPC(ReplayPC);;basePc:=Pcgs(baseR);;
baseWord:=v->Product([1..Length(basePc)],j->basePc[j]^v[j]);;
baseS:=baseWord(ReplayPC[4]);;baseT:=baseWord(ReplayPC[5]);;
qaS:=(1,2)(3,4);;qaR:=(1,2,3);;qa:=Group(qaS,qaR);;
qaIso:=IsomorphismPcGroup(qa);;qaPc:=Image(qaIso);;
prod:=DirectProduct(baseR,qaPc);;
ss:=Image(Embedding(prod,1),baseS)*Image(Embedding(prod,2),Image(qaIso,qaS));;
rr:=Image(Embedding(prod,1),baseT)*Image(Embedding(prod,2),Image(qaIso,qaR));;
source:=Group(ss,rr);;iso:=IsomorphismPcGroup(source);;
gp:=Image(iso);;sp:=Image(iso,ss);;rp:=Image(iso,rr);;
if Size(gp)<>4*Size(baseR) then Error("joint full source fiber product");fi;
qbase:=GroupHomomorphismByImages(gp,baseR,[sp,rp],[baseS,baseT]);;
qaff:=GroupHomomorphismByImages(gp,qa,[sp,rp],[qaS,qaR]);;
if qbase=fail or qaff=fail or not IsSurjective(qbase) or not IsSurjective(qaff) then Error("joint literal quotient maps");fi;
xx:=(sp*rp)^-2;;yy:=sp*xx*sp;;zz:=(xx*yy)^-1;;
brunn:=Comm(Comm(xx^2,yy^2),zz^2);;
Print("JOINT ACTUAL SOURCE: order=",Size(gp),"; source kernel order=",Size(Kernel(qbase)),"; brunnian qA4=",Image(qaff,brunn),"; brunnian qR=",Image(qbase,brunn),"\n");
if Image(qbase,brunn)<>One(baseR) or Image(qaff,brunn)=() then Error("exact source A4 separation word");fi;
pc:=Pcgs(gp);;n:=Length(pc);;
modu:=GModuleByMats(List(pc,g->IdentityMat(1,GF(2))),GF(2));;
Print("JOINT BINARY H2 START: pc length=",n,"; runtime=",Runtime(),"\n");
co:=TwoCohomology(gp,modu);;
basis:=BasisVectors(Basis(Range(co.cohom)));;
coc:=List(basis,v->PreImagesRepresentative(co.cohom,v));;
restrictions:=[];;
for v in coc do
 ext:=Extension(gp,modu,v);;ep:=Pcgs(ext);;z:=ep[n+1];;
 tl:=MappedPcElement(sp,pc,ep{[1..n]});;
 Add(restrictions,First([0..1],i->z^i=tl^2));
od;
allowed:=NullspaceMat(List(restrictions,i->[i*One(GF(2))]));;
combined:=List(allowed,row->Sum([1..Length(coc)],i->row[i]*coc[i]));;
d:=Length(combined);;
Print("JOINT BINARY H2: dimension=",Length(coc),"; source restrictions=",restrictions,"; marked dimension=",d,"; runtime=",Runtime(),"\n");
PCDataLocal:=function(gr,a,b)
 local pp,nn,pow,conj,i,j;
 pp:=Pcgs(gr);nn:=Length(pp);pow:=[];conj:=[];
 for i in [1..nn] do Add(pow,ExponentsOfPcElement(pp,pp[i]^RelativeOrders(pp)[i]));od;
 for i in [2..nn] do for j in [1..i-1] do Add(conj,[i,j,ExponentsOfPcElement(pp,pp[i]^pp[j])]);od;od;
 return [RelativeOrders(pp),pow,conj,ExponentsOfPcElement(pp,a),ExponentsOfPcElement(pp,b)];
end;;
stream:=OutputTextFile("work/centralizer_code/joint_source_affine_cover.json",false);;
SetPrintFormattingStatus(stream,false);;
PrintTo(stream,"{\"source_order\":",Size(gp),",\"pc\":",PCDataLocal(gp,sp,rp),",\"cocycles\":",List(combined,v->List(v,IntFFE)),",\"source_restrictions\":",restrictions,"}\n");;
CloseStream(stream);;
jointCoc:=Concatenation(List([1..Length(combined[1])],i->List([1..d],j->combined[j][i])));;
moduall:=GModuleByMats(List(pc,g->IdentityMat(d,GF(2))),GF(2));;
cover:=Extension(gp,moduall,jointCoc);;cp:=Pcgs(cover);;
lift:=g->MappedPcElement(g,pc,cp{[1..n]});;
cs:=lift(sp);;cr:=lift(rp)^4;;
if cs^2<>One(cover) or cr^3<>One(cover) or Size(Group(cs,cr))<>Size(cover) then Error("joint binary marked generation");fi;
pure:=Group(xx,yy);;centS:=Centralizer(pure,sp);;
centZero:=Intersection(centS,Kernel(qaff));;
CentralRow:=function(z)
 local v;
 v:=ExponentsOfPcElement(cp,z);
 if not ForAll(v{[1..n]},i->i=0) then Error("joint noncentral kappa");fi;
 return v{[n+1..n+d]}*One(GF(2));
end;;
kappaRows:=List(GeneratorsOfGroup(centS),g->CentralRow(Comm(lift(g),cs)));;
zeroRows:=List(GeneratorsOfGroup(centZero),g->CentralRow(Comm(lift(g),cs)));;
Print("JOINT BINARY KAPPA: full rank=",RankMat(kappaRows),"; zero-A4 rank=",RankMat(zeroRows),"; full source A4 image=",Elements(Image(qaff,centS)),"\n");
Print("JOINT FULL KAPPA ROWS: ",List(kappaRows,v->List(v,IntFFE)),"\n");
Print("JOINT ZERO-A4 KAPPA ROWS: ",List(zeroRows,v->List(v,IntFFE)),"\n");
Print("JOINT COMPLETE FIRST CENTRAL LAYER FINISHED\n");
QUIT_GAP(0);
