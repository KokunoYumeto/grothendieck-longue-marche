A12:=A^2;; A13:=B*A^2/B;; A23:=B^2;; A14:=D*B*A^2/B/D;; A24:=D*B^2/D;; A34:=D^2;;
P:=Group(A12,A13,A23,A14,A24,A34);;
Print("PURE_FOUR_ORDER ",Size(P)," DERIVED ",Size(DerivedSubgroup(P))," ABELIANIZATION ",AbelianInvariants(P),"\n");
S:=SylowSubgroup(P,2);; Print("PURE_SYLOW2_ORDER ",Size(S)," ABELIAN ",IsAbelian(S)," EXPONENT ",Exponent(S),"\n");
z:=A12*A13*A23*A14*A24*A34;; Print("FULL_TWIST_ORDER ",Order(z)," CENTRAL ",z in Center(P),"\n");
T3:=SylowSubgroup(P,3);; Print("PURE_SYLOW3_ORDER ",Size(T3)," NORMAL ",IsNormal(P,T3),"\n");
if IsNormal(P,T3) then Print("TWO_QUOTIENT_EXPONENT ",Exponent(FactorGroup(P,T3)),"\n"); fi;
if Size(P)<>3888 or Size(DerivedSubgroup(P))<>486 then Error("pure orders"); fi;
if Size(S)<>16 or IsAbelian(S) or Exponent(S)<>4 then Error("Sylow2"); fi;
if Order(z)<>3 or not z in Center(P) then Error("central full twist"); fi;
if Size(T3)<>243 or not IsNormal(P,T3) or Exponent(FactorGroup(P,T3))<>4 then Error("odd-normal quotient"); fi;
Print("PASS all actual pure-image and odd-normal-quotient assertions\n");
QUIT;
