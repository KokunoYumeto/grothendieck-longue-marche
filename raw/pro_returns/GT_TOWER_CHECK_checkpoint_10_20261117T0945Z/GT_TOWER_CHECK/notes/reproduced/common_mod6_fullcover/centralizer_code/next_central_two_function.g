# Exact first central-two layer for the next actual source.
# Load only after check_second_pullback_zero_target.g has passed its finite tests.
TestNextCentralTwo:=function(base,sbase,rbase,fbase)
 local pg,n,modul,coh,basis,coc,lift,bits,v,ext,pe,se,re,fe,bad,allowed,
       i,j,d,joint,cov,moduld,proj,aa,bb,obstruction,passS,passR;
 pg:=Pcgs(base);n:=Length(pg);
 modul:=GModuleByMats(List(pg,g->IdentityMat(1,GF(2))),GF(2));
 Print("NEXT H2(F2) START: PC length=",n,"; runtime=",Runtime(),".\n");
 coh:=TwoCohomology(base,modul);
 basis:=BasisVectors(Basis(Range(coh.cohom)));
 coc:=List(basis,v->PreImagesRepresentative(coh.cohom,v));
 Print("NEXT H2(F2) DIMENSION=",Length(coc),"; runtime=",Runtime(),".\n");
 bits:=[];
 for v in coc do
  ext:=Extension(base,modul,v);pe:=Pcgs(ext);
  se:=MappedPcElement(sbase,pg,pe{[1..n]});
  if se^2=One(ext) then Add(bits,0);else Add(bits,1);fi;
 od;
 bad:=Position(bits,1);allowed:=[];
 for i in [1..Length(coc)] do
  if i=bad then continue;fi;
  v:=coc[i];if bits[i]=1 then v:=v+coc[bad];fi;Add(allowed,v);
 od;
 d:=Length(allowed);
 Print("NEXT CANONICAL ELEMENTARY TWO KERNEL DIMENSION=",d,"; runtime=",Runtime(),".\n");
 if d=0 then return rec(dimension:=0,cycle:=true,positiveS:=true,positiveR:=true);fi;
 moduld:=GModuleByMats(List(pg,g->IdentityMat(d,GF(2))),GF(2));
 joint:=Concatenation(List([1..Length(allowed[1])],i->List([1..d],j->allowed[j][i])));
 cov:=Extension(base,moduld,joint);pe:=Pcgs(cov);
 se:=MappedPcElement(sbase,pg,pe{[1..n]});
 re:=MappedPcElement(rbase,pg,pe{[1..n]});re:=re*re^3;
 if se^2<>One(cov) or re^3<>One(cov) then Error("next central marked generators fail");fi;
 proj:=GroupHomomorphismByImages(cov,base,AsList(pe),Concatenation(AsList(pg),List([1..d],j->One(base))));
 if proj=fail or Size(Kernel(proj))<>2^d then Error("next central projection fail");fi;
 if Size(Group(se,re))<>Size(cov) then Error("next marked cover not generated by B");fi;
 fe:=MappedPcElement(fbase,pg,pe{[1..n]});aa:=(se*fe)^2;bb:=(fe^-1*re)^3;
 obstruction:=aa^3*bb^2;
 Print("NEXT CENTRAL TWO CYCLE OBSTRUCTION ZERO=",obstruction=One(cov),"; runtime=",Runtime(),".\n");
 if obstruction<>One(cov) then return rec(dimension:=d,cycle:=false);fi;
 fe:=fe*aa*bb;
 passS:=IsConjugate(cov,se,se*fe);
 Print("NEXT CENTRAL TWO POSITIVE S=",passS,"; runtime=",Runtime(),".\n");
 passR:=IsConjugate(cov,re,fe^-1*re);
 Print("NEXT CENTRAL TWO POSITIVE R=",passR,"; runtime=",Runtime(),".\n");
 return rec(dimension:=d,cycle:=true,positiveS:=passS,positiveR:=passR,
  group:=cov,s:=se,r:=re,f:=fe,projection:=proj,cohomology:=coh,cocycles:=coc,restriction:=bits);
end;
