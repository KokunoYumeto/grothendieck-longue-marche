x:=(r*s)^2;;y:=(s*r)^2;;Fg:=Subgroup(G,[x,y]);;
P:=G;;iso:=IdentityMapping(G);;ps:=s;;pr:=r;;
Assert(0,Size(G)=18366102701919111870287640813247479948797709553001809575936);;
Print("cached_pc_source_order ",Size(G),"\n");;
PBC_Tag:="iterated_joint_heap";;
Read("LM8_PUSH/code/pbc_heap_schur.g");;
epi:=PBC_HeapSchur(P);;
 H:=Source(epi);;
Print("schur_extension_orders ",RelativeOrdersOfPcp(Pcp(H)),"\n");
ks:=Kernel(epi);;
Print("schur_kernel_invariants ",AbelianInvariants(ks),"\n");
hs:=PreImagesRepresentative(epi,ps);;
hr:=PreImagesRepresentative(epi,pr);;
L:=Subgroup(H,[hs,hr]);;
Print("two_generator_extension_ab ",AbelianInvariants(L),"\n");
rels:=Subgroup(L,[hs^2,hr^3]);;
Assert(0,IsNormal(L,rels));
quo:=NaturalHomomorphismByNormalSubgroup(L,rels);;
PBC_Cover:=Image(quo);; es:=Image(quo,hs);; er:=Image(quo,hr);;
Print("modular_centralization_order ",Size(PBC_Cover),"\n");
q:=GroupHomomorphismByImages(PBC_Cover,P,[es,er],[ps,pr]);;
Print("central_kernel ",AbelianInvariants(Kernel(q)),"\n");
Assert(0,IsSubgroup(Centre(PBC_Cover),Kernel(q)));
bs:=bs^-1;;br:=br^-1;;
ebs:=PreImagesRepresentative(q,Image(iso,bs));;
ebr:=PreImagesRepresentative(q,Image(iso,br));;
as:=ebs*es*ebs^-1;; ar:=ebr*er*ebr^-1;;
delta:=as*ar*(es*er)^-1;;
Print("cusp_error_order ",Order(delta),"\n");
cs:=Centralizer(Fg,s);;cr:=Centralizer(Fg,r);;
js:=List(GeneratorsOfGroup(cs),g->Comm(PreImagesRepresentative(q,Image(iso,g)),es));;
jr:=List(GeneratorsOfGroup(cr),g->Comm(PreImagesRepresentative(q,Image(iso,g)),er));;
J:=Subgroup(PBC_Cover,Concatenation(js,jr));;
Print("boundary_commutator_order ",Size(J),"\n");
Print("obstruction_zero ",delta in J,"\n");

PBC_cs:=GeneratorsOfGroup(cs);;PBC_cr:=GeneratorsOfGroup(cr);;
PBC_lifts:=List(Concatenation(PBC_cs,PBC_cr),g->PreImagesRepresentative(q,Image(iso,g)));;
PBC_changes:=[];;
for PBC_i in [1..Length(PBC_lifts)] do
 PBC_c:=PBC_lifts[PBC_i];
 if PBC_i<=Length(PBC_cs) then
  Add(PBC_changes,(ebs*PBC_c)*es*(ebs*PBC_c)^-1*as^-1);
 else
  Add(PBC_changes,(ebr*PBC_c)*er*(ebr*PBC_c)^-1*ar^-1);
 fi;
od;

PBC_FreeChanges:=AbelianPcpGroup(Length(PBC_changes),ListWithIdenticalEntries(Length(PBC_changes),0));;
PBC_change_map:=GroupHomomorphismByImages(PBC_FreeChanges,J,GeneratorsOfGroup(PBC_FreeChanges),PBC_changes);;
PBC_pre:=PreImagesRepresentative(PBC_change_map,delta^-1);;
Assert(0,PBC_pre<>fail);
PBC_exps:=ExponentsByPcp(Pcp(PBC_FreeChanges),PBC_pre);;
PBC_word:=Filtered([1..Length(PBC_exps)],i->PBC_exps[i]<>0);;
PBC_word:=List(PBC_word,i->[i,PBC_exps[i]]);;
PBC_scor:=One(PBC_Cover);;PBC_rcor:=One(PBC_Cover);;
for PBC_j in [1..Length(PBC_exps)] do
 if PBC_j<=Length(PBC_cs) then
  PBC_scor:=PBC_scor*PBC_lifts[PBC_j]^PBC_exps[PBC_j];
 else
  PBC_rcor:=PBC_rcor*PBC_lifts[PBC_j]^PBC_exps[PBC_j];
 fi;
od;
PBC_bs:=ebs*PBC_scor;;PBC_br:=ebr*PBC_rcor;;
PBC_as:=PBC_bs*es*PBC_bs^-1;;PBC_ar:=PBC_br*er*PBC_br^-1;;
Assert(0,PBC_as*PBC_ar=es*er);
Print("correction_word ",PBC_word," s_generator_count ",Length(PBC_cs),"\n");
Print("corrected_cusp_exact ",PBC_as*PBC_ar=es*er,"\n");
PBC_Auto:=GroupHomomorphismByImages(PBC_Cover,PBC_Cover,[es,er],[PBC_as,PBC_ar]);;
Print("central_cover_automorphism ",PBC_Auto<>fail and IsBijective(PBC_Auto),"\n");
PBC_pciso:=IsomorphismPcGroup(PBC_Cover);;PBC_PC:=Image(PBC_pciso);;
PBC_pcgs:=Pcgs(PBC_PC);;PBC_orders:=RelativeOrders(PBC_pcgs);;
PBC_vector:=g->ExponentsOfPcElement(PBC_pcgs,Image(PBC_pciso,g));;
PBC_powers:=List([1..Length(PBC_pcgs)],i->ExponentsOfPcElement(PBC_pcgs,PBC_pcgs[i]^PBC_orders[i]));;
PBC_conj:=[];;
for PBC_i in [1..Length(PBC_pcgs)] do
 for PBC_j in [1..PBC_i-1] do
  Add(PBC_conj,[PBC_i,PBC_j,ExponentsOfPcElement(PBC_pcgs,PBC_pcgs[PBC_i]^PBC_pcgs[PBC_j])]);
 od;
od;
PBC_file:=Concatenation("LM8_PUSH/code/pbc_hopf_",PBC_Tag,"_certificate.json");;
PrintTo(PBC_file,"{\n\"order\":",Size(PBC_PC),",\n\"relative_orders\":",PBC_orders,",\n\"powers\":",PBC_powers,",\n\"conjugates\":",PBC_conj,",\n\"s\":",PBC_vector(es),",\n\"r\":",PBC_vector(er),",\n\"original_s_frame\":",PBC_vector(ebs),",\n\"original_r_frame\":",PBC_vector(ebr),",\n\"centralizer_lifts\":",List(PBC_lifts,PBC_vector),",\n\"s_centralizer_generator_count\":",Length(PBC_cs),",\n\"correction_word\":",PBC_word,",\n\"corrected_s_frame\":",PBC_vector(PBC_bs),",\n\"corrected_r_frame\":",PBC_vector(PBC_br),",\n\"corrected_s_image\":",PBC_vector(PBC_as),",\n\"corrected_r_image\":",PBC_vector(PBC_ar),"\n}\n");

QUIT;
