+def validate_restoration_targets(entries: list[dict]) -> set[tuple[str, ...]]:
+    """Reject target aliases and file/descendant conflicts; reserve all targets."""
+    declared: dict[tuple[str, ...], dict] = {}
+    for entry in entries:
+        parts = safe_relative_path(entry["path"]).parts
+        if not parts:
+            raise ValueError(f"Original path maps to the restoration root: {entry['path']!r}")
+        if parts in declared:
+            raise ValueError(
+                f"Original paths share a restoration target: "
+                f"{declared[parts]['path']!r} and {entry['path']!r}"
+            )
+        declared[parts] = entry
+    reserved = set(declared)
+    for parts, entry in declared.items():
+        for length in range(1, len(parts)):
+            parent = parts[:length]
+            if parent in declared and not declared[parent]["is_directory"]:
+                raise ValueError(
+                    f"Original file is also a restoration parent: "
+                    f"{declared[parent]['path']!r} and {entry['path']!r}"
+                )
+            reserved.add(parent)
+    return reserved
+
