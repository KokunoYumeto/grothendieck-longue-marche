        "Questions"
      ],
      "exact_tex": "\\uline{Questions} $\\widehat{\\mathcal T}_\\nu$ invariant dans $\\Gamma_\\nu$? $\\widehat{\\mathcal T}_\\nu^\\circ$ \\unsure{dist. ds} $\\Gamma_\\nu^\\circ$?"
    },
    {
      "scan": 98,
