\\ E101: all first-step unit/S-unit norm coordinates and exact inverses.
default(parisize,256000000);
default(parisizemax,2000000000);
default(realprecision,100);
check(b,s)=if(!b,error(s));
jm(A)=vector(matsize(A)[1],i,vector(matsize(A)[2],j,lift(A[i,j])));
jq(q)=[numerator(q),denominator(q)];
jr(A)=vector(matsize(A)[1],i,vector(matsize(A)[2],j,jq(A[i,j])));
jpoly(p,n)=vector(n,i,jq(polcoef(lift(p),i-1)));
emit(n,v)=print("{\"name\":\"",n,"\",\"value\":",v,"}");
sdcoord(B,F,SU,V,ps,un,tors,u)={
 my(v=vector(6,j,idealval(F,u,ps[j]))~,se=V^-1*v);
 check(denominator(se)==1,"principal S-divisor coordinate");
 my(w=u/prod(j=1,6,SU[1][j]^se[j]),q=bnfisunit(B,w));
 check(#q==9,"ordinary unit coordinate");
 my(vv=concat(concat([lift(Mod(tors*q[9],9))],vector(8,j,q[j])),Vec(se))~);
 my(rec=prod(j=1,15,un[j]^vv[j]));
 check(u/rec==1 || u/rec==-1,"exact coordinate reconstruction modulo prime-to-three torsion");
 vv;
};
export_kernel(tag,M)={
 my(H=mathnf(matsolvemod(M,3,0,1)[2]),SM=matsnf(H,1),ds=vector(matsize(H)[1],i,SM[3][i,i]));
 check(SM[1]*H*SM[2]==SM[3],"exact Smith identity");
 check(lift(Mod(M*H,3))==matrix(matsize(M)[1],matsize(H)[2]),"integral kernel inclusion");
 my(rank=matrank(Mod(M,3)));check(abs(matdet(H))==3^rank,"complete kernel index");
 emit(Str(tag,"_matrix"),jm(M));emit(Str(tag,"_kernel_hnf"),jm(H));
 emit(Str(tag,"_kernel_inverse"),jr(H^-1));
 emit(Str(tag,"_smith_left"),jm(SM[1]));emit(Str(tag,"_smith_right"),jm(SM[2]));
 emit(Str(tag,"_smith_left_inverse"),jm(SM[1]^-1));emit(Str(tag,"_smith_right_inverse"),jm(SM[2]^-1));
 emit(Str(tag,"_smith_diagonal"),ds);
 my(rowindices=matindexrank(Mod(M,3))[1],P=vecextract(M,rowindices,".."),colindices=matindexrank(Mod(P,3))[2]);
 my(C=vecextract(Mod(P,3),"..",colindices),CI=C^-1,section=matrix(matsize(M)[2],rank));
 for(i=1,rank,for(j=1,rank,section[colindices[i],j]=lift(CI[i,j])));
 check(Mod(P*section,3)==matid(rank),"actual quotient section");
 emit(Str(tag,"_independent_rows"),Vec(rowindices));emit(Str(tag,"_quotient_map"),jm(P));
 emit(Str(tag,"_quotient_section"),jm(section));
 my(tor=vector(matsize(H)[1],i,if(i==1,9,0))~,rel=H^-1*tor);
 check(denominator(rel)==1 && gcd(Vec(rel))==3,"exact torsion relation in image lattice");
 emit(Str(tag,"_image_torsion_relation"),Vec(rel));
 [M,H,SM,P,section,rel];
};
run()={
 my(dat=read("research_norm_index/code/cyclotomic_base1_bnf.bin"),B=dat[1],F=B.nf,xi=dat[2],a=dat[3],z=xi^3,beta=a*xi);
 check(Mod(x,F.pol)==a-xi,"literal B1 primitive element");
 my(ps=concat(idealprimedec(F,3),idealprimedec(F,17)),SU=bnfsunit(B,ps),V=matrix(6,6,i,j,idealval(F,SU[1][j],ps[i])));
 my(un=concat(concat([xi],B.fu),SU[1]),xu=bnfisunit(B,xi),tors=lift(Mod(xu[#xu],9)^-1));
 my(loc=read("research_norm_index/code/cyclotomic_base1_local_norms.bin"),M=matrix(6,15),pi=beta+1);
 for(j=1,3,for(k=1,15,my(v=idealval(F,un[k],ps[j]),u=nfeltdiv(F,un[k],pi^v));M[j,k]=lift(Mod(loc[2][j]~*ideallog(F,u,loc[1][j]),3))));
 for(j=4,6,my(bid=idealstar(F,ps[j],2,3));for(k=1,15,my(v=idealval(F,un[k],ps[j]),u=nfeltdiv(F,un[k],beta^v));M[j,k]=ideallog(F,u,bid)[1]));
 my(Q=matker(Mod(M,3)),ga=nfalgtobasis(F,z*a-xi),ha=nfalgtobasis(F,z^2*a-z*xi),G=matrix(15,15),H=matrix(15,15));
 for(j=1,15,G[,j]=sdcoord(B,F,SU,V,ps,un,tors,nfbasistoalg(F,nfgaloisapply(F,ga,nfalgtobasis(F,un[j]))));H[,j]=sdcoord(B,F,SU,V,ps,un,tors,nfbasistoalg(F,nfgaloisapply(F,ha,nfalgtobasis(F,un[j])))));
 check(Mod(G,3)^3==matid(15) && Mod(H,3)^3==matid(15) && Mod(G*H-H*G,3)==matrix(15,15),"actual normalizer actions modulo cubes");
 check(Mod(M*G,3)*Q==matrix(6,10) && Mod(M*H,3)*Q==matrix(6,10),"field norm kernel preserved");
 my(lo=read("research_e86/code/e_stable_lower_genus.bin"),BL=lo[1],L=BL.nf,b=Mod(x,L.pol),zz=b^3/17,c1=b+1+3*zz,lp=concat(idealprimedec(L,3),idealprimedec(L,17)));
 my(E=matrix(18,6,i,j,nfalgtobasis(F,subst(lift(L.zk[j]),x,beta))[i]),inv=(E~*E)^-1*E~,rr=matrix(5,15),tu=bnfisunit(BL,zz),tinv=lift(Mod(tu[3],3)^-1));
 for(j=1,15,
   my(u=nfalgtobasis(F,un[j]),hu=nfgaloisapply(F,ha,u),hhu=nfgaloisapply(F,ha,hu),nn=nfeltmul(F,nfeltmul(F,u,hu),hhu),nv=inv*nn);
   check(E*nv==nn,"actual horizontal contraction");
   my(nu=nfbasistoalg(L,nv),v3=idealval(L,nu,lp[1]),v17=idealval(L,nu,lp[2]),ou=nu/(c1^v3*b^v17),uc=bnfisunit(BL,ou));
   check(#uc==3,"lower ordinary unit coordinates");
   rr[,j]=[lift(Mod(tinv*uc[3],3)),uc[1],uc[2],v3,v17]~;
   my(rec=zz^rr[1,j]*BL.fu[1]^rr[2,j]*BL.fu[2]^rr[3,j]*c1^rr[4,j]*b^rr[5,j]);
   check(nu/rec==1 || nu/rec==-1,"literal horizontal norm reconstruction");
 );
 my(NQ=Mod(rr,3)*Q);
 check(matrank(NQ)==2 && NQ[2,]==NQ[3,] && NQ[4,]==vector(10) && NQ[5,]==vector(10),"complete horizontal image on field norms");
 my(Phi=matrix(7,15,i,j,if(i<=6,M[i,j],lift(Mod(rr[1,j]+2*rr[2,j],3)))));
 check(matrank(Mod(Phi,3))==6,"complete S-unit norm index");
 my(ordinary=vecextract(Phi,"..","1..9"));check(matrank(Mod(ordinary,3))==4,"complete ordinary B-unit norm index");
 my(bv=sdcoord(B,F,SU,V,ps,un,tors,beta),cv=sdcoord(B,F,SU,V,ps,un,tors,xi*(beta+1+3*z)));
 check(Mod(Phi*bv,3)==vector(7)~, "literal beta norm");
 check(Mod(M*cv,3)==vector(6)~ && Mod(Phi[7,]*cv,3)==1,"E97 exact corrected target defect");
 emit("B1_polynomial",vector(19,i,polcoef(F.pol,i-1)));
 emit("B1_generators",vector(15,i,jpoly(un[i],18)));
 emit("principal_S_divisor_matrix",jm(V));emit("g_action",jm(G));emit("h_action",jm(H));
 emit("field_norm_matrix",jm(M));emit("field_norm_kernel",jm(Q));
 emit("horizontal_norm_matrix",jm(rr));emit("horizontal_norm_on_kernel",jm(NQ));
 emit("horizontal_embedding",jr(E));emit("horizontal_projection_inverse",jr(inv));
 emit("known_beta_norm",Vec(bv));emit("known_xic1_defect",Vec(cv));
 my(sk=export_kernel("S_unit",Phi),uk=export_kernel("ordinary_B_unit",ordinary));
 my(gnew=[1,1,1,1,1,2]~,U=vecextract(M,"..","1..9"));
 check(matrank(Mod(concat(U,gnew),3))==matrank(Mod(U,3)) && Mod(gnew-2*U[,1],3)==vector(6)~, "new L2 residue does not enlarge included local-character image");
 emit("ordinary_local_character_rank",matrank(Mod(U,3)));emit("new_L2_unit_local_column",Vec(gnew));
 writebin("research_e101/code/e_unit_norm_coordinates.bin",[B,un,SU,V,M,Q,G,H,rr,E,inv,Phi,sk,uk,bv,cv]);
 print("{\"type\":\"completion\",\"status\":\"PASS\",\"statement\":\"E.101\",\"S_norm_quotient_rank\":6,\"ordinary_B_norm_quotient_rank\":4}");
};
run();
quit;
