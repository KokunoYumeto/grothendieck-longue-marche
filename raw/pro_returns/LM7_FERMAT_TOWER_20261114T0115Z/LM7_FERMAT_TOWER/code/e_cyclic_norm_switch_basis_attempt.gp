\\ E97 exploratory exact norm switch: no new upper BNF computation.
default(parisize,256000000);
default(parisizemax,2000000000);
default(realprecision,100);
setrand(971713);
check(b,s)=if(!b,error(s));
run()={
  my(lo=read("research_e86/code/e_stable_lower_genus.bin"),BL=lo[1],FL=BL.nf,pl=FL.pol,b=Mod(x,pl),z=b^3/17);
  my(up=read("research_norm_index/code/cyclotomic_base1_bnf.bin"),BU=up[1],FU=BU.nf,xi=up[2],aa=up[3],bb=aa*xi,zz=xi^3);
  my(h=nfalgtobasis(FU,zz^2*aa-zz*xi),H=matrix(18,18,i,j,nfgaloisapply(FU,h,FU.zk[j])[i]));
  check(H^3==matid(18),"literal horizontal cubic automorphism");
  my(E=matrix(18,6,i,j,nfalgtobasis(FU,bb^(j-1))[i]),D=(E~*E)^-1*E~);
  check(D*E==matid(6),"actual field inclusion inverse");
  my(SL=List(),SU=List());
  for(i=1,4,my(p=[3,17,7,73][i]);for(j=1,#idealprimedec(FL,p),listput(SL,idealprimedec(FL,p)[j]));for(j=1,#idealprimedec(FU,p),listput(SU,idealprimedec(FU,p)[j])));
  my(UL=bnfunits(BL,Vec(SL)),UU=bnfunits(BU,Vec(SU)),nu=#UU[1],nl=#UL[1],M=matrix(nl,nu),gens=vector(nu),norms=vector(nu));
  print("FIELDS ",pl," ",FU.pol," S_UNIT_DIMENSIONS ",[nl,nu]);
  for(j=1,nu,
    my(u=nffactorback(FU,UU[1][j]),v=nfeltmul(FU,nfeltmul(FU,u,H*u),H^2*u),d=D*v);
    check(E*d==v,"norm lies in literal lower field");
    my(nm=Mod(sum(i=1,6,d[i]*x^(i-1)),pl),c=bnfisunit(BL,nm,UL));
    check(#c==nl,"actual lower S-unit coordinates");
    M[,j]=c;gens[j]=u;norms[j]=nm;
  );
  my(target=bnfisunit(BL,b,UL),mods=vector(nl,i,if(i==nl,BL.tu[1],0))~,sol=matsolvemod(M,mods,target));
  check(type(sol)=="t_COL","actual horizontal field-norm equation");
  my(u=nffactorback(FU,gens,sol),v=nfeltmul(FU,nfeltmul(FU,u,H*u),H^2*u));
  check(v==nfalgtobasis(FU,bb),"literal norm beta1");
  print("NORM_BETA1_EXPONENTS ",sol);
  print("NORM_BETA1_WITNESS ",lift(nfbasistoalg(FU,u)));
  my(Basis=matrix(18,18,i,j,nfalgtobasis(FU,bb^((j-1)%6)*xi^((j-1)\6))[i]),cc=Basis^-1*u,Y=varhigher("Y",x),urel=Mod(sum(j=0,2,sum(i=0,5,cc[1+i+6*j]*b^i)*Y^j),Y^3-z));
  check(norm(urel)==b,"relative horizontal norm identity");
  my(A=[0,0,z;1,0,0;0,1,0],S=matdiagonal([1,z,z^2]),U=sum(j=0,2,polcoef(lift(urel),j,Y)*A^j),BB=U*S);
  check(BB^3==b*matid(3) && BB*A==z*A*BB,"actual split cyclic algebra matrices");
  my(Z=varhigher("Z",Y),tt=Mod(Z,Z^3-b),ker=matker(BB-tt*matid(3)));
  check(matsize(ker)==[3,1],"one-dimensional beta2 eigenspace");
  my(w=ker[,1],tw=vector(3,i,Mod(subst(lift(w[i]),Z,z*Z),Z^3-b))~,Aw=A*w,ans);
  for(i=1,3,if(tw[i]!=0,ans=Aw[i]/tw[i];break));
  check(Aw==ans*tw && norm(ans)==z,"exact switched norm zeta");
  print("RELATIVE_ZETA_NORM_WITNESS ",ans);
  my(pa=x^18+17*x^9+289,t=Mod(x,pa),al=Mod(0,pa));
  for(j=0,2,my(cj=polcoef(lift(ans),j,Z));al+=subst(lift(cj),x,t^3)*t^j);
  my(L=read("research_norm_index/code/prime3_field2.bin")[1],ss=nfalgtobasis(L,t*(t^9/17)),av=nfalgtobasis(L,al));
  check(nfeltmul(L,nfeltmul(L,av,nfgaloisapply(L,ss,av)),nfgaloisapply(L,ss,nfgaloisapply(L,ss,av)))==nfalgtobasis(L,t^9/17),"absolute norm zeta");
  print("ABSOLUTE_ZETA_NORM_WITNESS ",lift(al));
  my(fac=idealfactor(L,al));
  print("WITNESS_IDEAL_FACTORIZATION ",fac);
  writebin("research_e97/code/e_cyclic_norm_switch.bin",[BL,BU,E,D,H,Vec(SL),Vec(SU),UL,UU,M,mods,target,sol,gens,norms,u,urel,A,BB,w,ans,L,al,fac]);
  print("DONE_EXACT_NORM_SWITCH");
};
run();
quit;
