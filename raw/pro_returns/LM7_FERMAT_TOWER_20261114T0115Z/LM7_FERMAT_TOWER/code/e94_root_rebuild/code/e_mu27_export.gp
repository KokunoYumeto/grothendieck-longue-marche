default(parisize,256000000);
default(parisizemax,2000000000);
jmat(M)=concat(["[",concat(vector(matsize(M)[1],i,concat([if(i>1,",",""),Str(Vec(M[i,]))]))),"]"]);
jobj(label,M)=print("{\"type\":\"matrix\",\"name\":\"",label,"\",\"value\":",jmat(M),"}");
jvec(label,v)=print("{\"type\":\"vector\",\"name\":\"",label,"\",\"value\":",Vec(v),"}");
run()={
  my(L=read("research_e94/code/e_mu27_local.bin"),D=read("research_e94/code/e_mu27_genus.bin"),old=read("research_norm_index/code/cyclotomic_base1_ninth_genus.bin"));
  my(R=D[1],r=#R.cyc,H=D[2],S=D[3],K=D[5],P=D[6],KS=D[7],HS=D[8],SS=D[9],PS=D[10],KSS=D[11],oldmap=D[20]);
  jvec("ray_orders",R.cyc);jobj("ordinary_hnf",H);jobj("ordinary_left",S[1]);jobj("ordinary_right",S[2]);jobj("ordinary_diagonal",S[3]);jobj("ordinary_left_inverse",S[1]^-1);jobj("ordinary_right_inverse",S[2]^-1);
  jobj("kummer_characters",D[4]);jobj("kernel_basis",K);jobj("kernel_inverse_numerator",27*K^-1);
  jobj("relative_ordinary_presentation",P);jobj("relative_ordinary_left",KS[1]);jobj("relative_ordinary_right",KS[2]);jobj("relative_ordinary_diagonal",KS[3]);jobj("relative_ordinary_left_inverse",KS[1]^-1);jobj("relative_ordinary_right_inverse",KS[2]^-1);
  jobj("S_hnf",HS);jobj("S_left",SS[1]);jobj("S_right",SS[2]);jobj("S_diagonal",SS[3]);jobj("S_left_inverse",SS[1]^-1);jobj("S_right_inverse",SS[2]^-1);
  jobj("relative_S_presentation",PS);jobj("relative_S_left",KSS[1]);jobj("relative_S_right",KSS[2]);jobj("relative_S_diagonal",KSS[3]);jobj("relative_S_left_inverse",KSS[1]^-1);jobj("relative_S_right_inverse",KSS[2]^-1);
  jobj("ray_G",D[13]);jobj("ray_H",D[14]);jvec("base_S_class_row",D[12]);jobj("old_ray_restriction",oldmap);jobj("source_ray_basis",D[21]);jobj("source_ray_inverse",D[22]);jobj("old_ray_basis",D[23]);
  jobj("old_genus_hnf",old[4]);jobj("old_genus_left",old[5]);jobj("old_genus_diagonal",old[7]);
  my(neword=[9,9,9,3],oldord=[9,9,3],sord=[9,3],newlift=(K*KS[1]^-1)[,1..4]);
  my(N=(old[5]*oldmap*newlift)[2..4,]);
  for(i=1,3,for(j=1,4,N[i,j]=lift(Mod(N[i,j],oldord[i]))));
  my(NK=mathnf(matsolvemod(N,oldord~,0,1)[2]),NKP=NK^-1*matdiagonal(neword),NKS=matsnf(NKP,1));
  if(denominator(NKP)!=1 || prod(i=1,4,NKS[3][i,i])!=9 || vecmax(vector(4,i,NKS[3][i,i]))!=3,error("exact genus norm kernel"));
  my(right=matrix(4,3));for(j=1,3,right[,j]=matsolvemod(N,oldord~,matid(3)[,j]));
  my(J=3*right);for(i=1,4,for(j=1,3,J[i,j]=lift(Mod(J[i,j],neword[i]))));
  if(denominator(matdiagonal(neword)^-1*(J*N-3*matid(4)))!=1 || denominator(matdiagonal(oldord)^-1*(N*J-3*matid(3)))!=1,error("norm transfer compositions"));
  jobj("ordinary_norm_to_B3_genus",N);jobj("ordinary_norm_right_lifts",right);jobj("ordinary_transfer_from_B3_genus",J);
  jobj("ordinary_norm_kernel_basis",NK);jobj("ordinary_norm_kernel_presentation",NKP);jobj("ordinary_norm_kernel_left",NKS[1]);jobj("ordinary_norm_kernel_right",NKS[2]);jobj("ordinary_norm_kernel_diagonal",NKS[3]);
  my(Q=KSS[1]*KS[1]^-1);Q=Q[1..2,1..4];for(i=1,2,for(j=1,4,Q[i,j]=lift(Mod(Q[i,j],sord[i]))));
  jobj("ordinary_to_S_quotient",Q);
  my(C=matrix(4,6),CS=matrix(2,6));
  for(j=1,6,
    my(v=K^-1*D[17][j][5],x=KS[1]*v,y=KSS[1]*v);
    if(denominator(v)!=1,error("ramified Frobenius lies outside kernel"));
    for(i=1,4,C[i,j]=lift(Mod(x[i],neword[i])));
    for(i=1,2,CS[i,j]=lift(Mod(y[i],sord[i])));
  );
  if(CS!=matrix(2,6),error("S-prime classes in S quotient"));
  jobj("actual_six_S_prime_classes",C);jobj("actual_six_S_prime_classes_after_removal",CS);
  my(oldQ=[6,6,6,6,3,0;0,6,3,5,8,5;2,2,2,1,1,1],normQ=matrix(3,6,i,j,lift(Mod((N*C)[i,j],oldord[i]))));
  for(j=1,6,for(i=1,3,if(normQ[i,j]!=lift(Mod(if(j<=3,1,3)*oldQ[i,j],oldord[i])),error("exact ramified ideal norm coefficient"))));
  for(j=1,6,for(i=1,4,if(lift(Mod((J*oldQ)[i,j]-if(j<=3,3,1)*C[i,j],neword[i])),error("exact ramified ideal extension coefficient"))));
  jobj("six_S_prime_norms_to_B3_genus",normQ);
  my(Snorm=(D[12]*K*KSS[1]^-1)[1..2]);
  jvec("relative_S_norm_to_original_C3",lift(Mod(Snorm,3)));
  for(z=1,2,
    my(A=if(z==1,D[13],D[14]),sA=(KSS[1]*K^-1*A*K*KSS[1]^-1)[1..2,1..2],oA=(KS[1]*K^-1*A*K*KS[1]^-1)[1..4,1..4]);
    for(i=1,2,for(j=1,2,sA[i,j]=lift(Mod(sA[i,j],sord[i]))));
    for(i=1,4,for(j=1,4,oA[i,j]=lift(Mod(oA[i,j],neword[i]))));
    jobj(if(z==1,"relative_S_G","relative_S_H"),sA);jobj(if(z==1,"relative_ordinary_G","relative_ordinary_H"),oA);
  );
  jobj("S_valuation_matrix",L[9]);jobj("radical_S_characters",L[15]);jobj("cyclotomic_S_characters",L[16]);jvec("actual_radical_weights",L[17]);
  jobj("S_local_image_hnf",L[18]);jobj("S_local_image_left",L[19][1]);jobj("S_local_image_right",L[19][2]);jobj("S_local_image_diagonal",L[19][3]);
  jobj("field_norm_kernel",L[20]);jobj("cyclotomic_on_field_norm_kernel",L[21]);
  jobj("ordinary_local_image_hnf",L[22]);jobj("ordinary_local_image_left",L[23][1]);jobj("ordinary_local_image_right",L[23][2]);jobj("ordinary_local_image_diagonal",L[23][3]);
  my(rad=read("research_norm_index/code/cyclotomic_base1_ninth_norms.bin"));
  for(j=1,3,
    jvec(Str("radical_local_row_",j),rad[3][j][1][1,]);
    jvec(Str("cyclotomic_local_row_",j),L[12][j]);jobj(Str("joint_local_kernel_",j),L[13][j]);jobj(Str("joint_local_left_",j),L[14][j][1]);jobj(Str("joint_local_right_",j),L[14][j][2]);jobj(Str("joint_local_diagonal_",j),L[14][j][3]);jobj(Str("actual_cyclotomic_norm_columns_",j),L[11][j]);
  );
  print("{\"type\":\"completion\",\"status\":\"PASS\",\"relative_ordinary_orders\":[9,9,9,3],\"relative_S_orders\":[9,3],\"ordinary_genus_norm_kernel_orders\":[3,3],\"S_genus_norm_kernel_orders\":[3,3],\"mu27_degree\":3,\"Q_ramification\":3,\"T_residue_degree\":3}");
  print("DONE: full mu27 finite certificates and literal class-map coordinates.");
};
run();
quit;
