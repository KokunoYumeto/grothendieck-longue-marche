for i in [2..Length(PBC_pc)] do
 for j in [1..i-1] do
  Add(PBC_conj,[i,j,ExponentsOfPcElement(PBC_pc,PBC_pc[i]^PBC_pc[j])]);
 od;
od;
PrintTo("LM8_PUSH/code/pbc_suffix3_sylow3_presentation.json","{\n\"source_sha256\":\"2f3a8b452f6bf1644fa64e410d0ee520ab8b8a4b3614184c1cdd91fa9be0ba82\",\n\"order\":",Size(PBC_P),",\n\"relative_orders\":",PBC_ord,",\n\"powers\":",PBC_pow,",\n\"conjugates\":",PBC_conj,",\n\"embedding_in_actual_quotient_pcgs\":",PBC_emb,",\n\"derived_factor_exponents\":",PBC_exps,",\n\"hs_square_product_bound\":",PBC_bound,"\n}\n");
Print("SYLOW3_DERIVED_EXPONENTS ",PBC_exps," HS_BOUND ",PBC_bound," RUNTIME_MS ",Runtime()-PBC_start,"\n");
PBC_iso:=IsomorphismPcpGroup(PBC_P);;
PBC_Pcp:=Image(PBC_iso);;
Assert(0,Size(PBC_Pcp)=Size(PBC_P));
Print("SCHUR_MULTIPLIER_STARTED pc_generators ",Length(Igs(PBC_Pcp)),"\n");
PBC_mult:=AbelianInvariantsMultiplier(PBC_Pcp);;
Assert(0,ForAll(PBC_mult,e->e>0 and IsPower(3,e)));
if Length(PBC_mult)=0 then PBC_exp:=1;else PBC_exp:=Lcm(PBC_mult);fi;
Print("ACTUAL_SYLOW3_MULTIPLIER ",PBC_mult," EXPONENT ",PBC_exp," RUNTIME_MS ",Runtime()-PBC_start,"\n");
PrintTo("LM8_PUSH/code/pbc_suffix3_sylow3_multiplier.json","{\n\"source_sha256\":\"2f3a8b452f6bf1644fa64e410d0ee520ab8b8a4b3614184c1cdd91fa9be0ba82\",\n\"sylow_order\":",Size(PBC_P),",\n\"multiplier_invariants\":",PBC_mult,",\n\"multiplier_exponent\":",PBC_exp,",\n\"derived_factor_exponents\":",PBC_exps,",\n\"hs_square_product_bound\":",PBC_bound,",\n\"runtime_ms\":",Runtime()-PBC_start,"\n}\n");
Print("SYLOW3_MULTIPLIER_COMPLETE\n");
QUIT;
