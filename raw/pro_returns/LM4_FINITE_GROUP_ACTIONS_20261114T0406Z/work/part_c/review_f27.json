  "mathematical_criteria": [
    {
      "criterion": "actual_source_and_sign_maps",
      "status": "PASS",
      "finding": "Exact old indices 0..10 and negative seeds 13,14,17,18,21,22,25,26 match the frozen original braids and universal data; seed 25 and B1 are the literal named source elements. F23.13 forward/inverse maps carry both actual marginal inclusions and the specified positive basis."
    },
    {
      "criterion": "all_scalar_field_cases",
      "status": "PASS",
      "finding": "c=1 follows from actual normal generation inside the abelian translation image. Equal fields use F25. In the remaining class k0=k1(s)=k1(t), so s,t lie outside k1 and every determinant/localization factor is nonzero in every characteristic."
    },
    {
      "criterion": "continuous_cocycles_and_principal_quotient",
      "status": "PASS",
      "finding": "The finite affine target and universal property of the original free profinite completion give exactly seven cocycle coordinates. P,S have the displayed inverse identities modulo the principal line, with delta7 nonzero."
    },
    {
      "criterion": "basis_and_source_actions",
      "status": "PASS",
      "finding": "J and J^-1 compose to identity. All eleven actual source actions, lower diagonal blocks, line characters and principal corrections agree with independent literal-word calculations."
    },
    {
      "criterion": "five_commutator_determinant",
      "status": "PASS",
      "finding": "Printed gH agrees entrywise with the five actual commutator rows. Both determinant formulas pass replay. A separate written row-operation/block determinant calculation derives det H without inverting an integer prime."
    },
    {
      "criterion": "essential_line_all_characteristics",
      "status": "PASS",
      "finding": "The common kernel of the five additive commutators is the first line; any invariant subspace outside that line maps nontrivially into it. No semisimplicity or extra source operators are assumed."
    },
    {
      "criterion": "actual_seed_membership_and_recursion",
      "status": "PASS",
      "finding": "a is actual seed index25 in K. B1 preserves K and its character. kappa and all B1^r(kappa) belong to K and have character1. The principal correction pi1=-c gives the exact recursive evaluations."
    },
    {
      "criterion": "frobenius_maps_and_vandermonde_inverse",
      "status": "PASS",
      "finding": "The coefficient Frobenius maps have explicit inverse powers, preserve continuous cocycles/principals and commute with actual source precomposition. The field generator s has distinct Frobenius conjugates. The Lagrange-polynomial inverse evaluates to Kronecker deltas on those conjugates."
    },
    {
      "criterion": "summed_h1_injection",
      "status": "PASS",
      "finding": "A least-dimensional nonzero invariant kernel subspace projects injectively to simple invariant images; each image must equal its essential line. The actual evaluation Vandermonde is injective on their entire sum, contradiction."
    },
    {
      "criterion": "cocycle_and_trace_kernels",
      "status": "PASS",
      "finding": "The summed cocycle kernel consists exactly of principal parameters summing to zero, dimension m-1 and rank6m+1. The trace kernel is exactly the F26 principal trace-zero subspace, also when characteristic divides m."
    },
    {
      "criterion": "larger_coefficient_fields",
      "status": "PASS",
      "finding": "F26 coefficient reduction retains the original scalar character and fields. It would send every proper original affine marginal to a nonprincipal trace-kernel element; the proved kernel excludes it."
    },
    {
      "criterion": "certificate_code_and_evidence",
      "status": "PASS",
      "finding": "Both programs were read in full; all32 final manifest bindings verify. The independent dictionary/word evaluator and 120-term determinant were rerun in isolation, and the printed-formula checker replay matches root byte for byte."
    }
